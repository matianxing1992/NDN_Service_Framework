+void
+Consumer::clearCache()
+{
+  ++m_cacheGeneration;
+
+  std::vector<ErrorCallback> invalidatedCallbacks;
+  for (const auto& [_, tasks] : m_pendingCallbacks) {
+    for (const auto& task : tasks) {
+      if (task.onError)
+        invalidatedCallbacks.push_back(task.onError);
+    }
+  }
+  m_pendingCallbacks.clear();
+  m_ckInterestsSent.clear();
+
+  for (auto& [_, encryptedAes] : m_ckEncAesCache) {
+    std::fill(encryptedAes.begin(), encryptedAes.end(), 0);
+  }
+  m_ckEncAesCache.clear();
+  std::fill(m_keyCache.m_prv.begin(), m_keyCache.m_prv.end(), '\0');
+  m_keyCache.m_prv.clear();
+
+  for (const auto& callback : invalidatedCallbacks) {
+    callback("NAC-ABE cache invalidated by Controller policy update");
+  }
+}
