diff --git a/tests/unit-tests/consumer-revocation.t.cpp b/tests/unit-tests/consumer-revocation.t.cpp
new file mode 100644
index 0000000..b851825
--- /dev/null
+++ b/tests/unit-tests/consumer-revocation.t.cpp
@@ -0,0 +1,130 @@
+#include "consumer.hpp"
+#include "producer.hpp"
+#include "attribute-authority.hpp"
+#include "test-common.hpp"
+
+#include <ndn-cxx/security/validator-null.hpp>
+#include <ndn-cxx/util/dummy-client-face.hpp>
+
+namespace ndn::nacabe::tests {
+
+// Real segmented transport and crypto; signature-policy decisions are outside
+// this fixture's cache-invalidation boundary.
+class ConsumerRevocationFixture : public IdentityManagementTimeFixture
+{
+public:
+  ConsumerRevocationFixture()
+    : aaFace(io, m_keyChain, {false, true})
+    , producerFace(io, m_keyChain, {false, true})
+    , consumerFace(io, m_keyChain, {false, true})
+  {
+    producerFace.linkTo(aaFace);
+    producerFace.linkTo(consumerFace);
+    const auto aaCert = addIdentity("/revocation/aa").getDefaultKey().getDefaultCertificate();
+    const auto consumerCert = addIdentity("/revocation/user", RsaKeyParams())
+                                .getDefaultKey().getDefaultCertificate();
+    const auto producerCert = addIdentity("/revocation/provider").getDefaultKey().getDefaultCertificate();
+    aa = std::make_unique<CpAttributeAuthority>(aaCert, aaFace, validator, m_keyChain);
+    aa->addNewPolicy(consumerCert, {"attr1"});
+    advanceClocks(time::milliseconds(20), 60);
+    consumer = std::make_unique<Consumer>(consumerFace, m_keyChain, validator, consumerCert, aaCert);
+    producer = std::make_unique<Producer>(producerFace, m_keyChain, validator,
+                                          producerCert, aaCert, producerCert);
+    advanceClocks(time::milliseconds(20), 60);
+    consumer->obtainDecryptionKey();
+    advanceClocks(time::milliseconds(20), 60);
+    BOOST_REQUIRE(consumer->readyForDecryption());
+    std::tie(data, ck) = producer->produce(Name("/payload"), "attr1", Buffer{1, 2, 3},
+                                           security::signingByCertificate(producerCert));
+    BOOST_REQUIRE_EQUAL(data.size(), 1U);
+    BOOST_REQUIRE(!ck.empty());
+    dataName = data.front()->getName().getPrefix(-1);
+    producerFace.setInterestFilter(producerCert.getIdentity(),
+      [this] (const InterestFilter&, const Interest& interest) {
+        for (const auto& packet : data) {
+          if (interest.matchesData(*packet)) {
+            ++dataRequests;
+            if (!holdData) producerFace.put(*packet);
+            return;
+          }
+        }
+        for (const auto& packet : ck) {
+          if (interest.matchesData(*packet)) {
+            ++ckRequests;
+            if (!holdCk) producerFace.put(*packet);
+            return;
+          }
+        }
+      });
+    advanceClocks(time::milliseconds(10), 2);
+  }
+
+  void consume()
+  {
+    consumer->consume(dataName,
+      [this] (const Buffer& plain) {
+        BOOST_CHECK(plain == Buffer({1, 2, 3}));
+        ++successes;
+      }, [this] (const std::string&) { ++errors; });
+  }
+
+  DummyClientFace aaFace, producerFace, consumerFace;
+  security::ValidatorNull validator;
+  std::unique_ptr<CpAttributeAuthority> aa;
+  std::unique_ptr<Consumer> consumer;
+  std::unique_ptr<Producer> producer;
+  SPtrVector<Data> data, ck;
+  Name dataName;
+  bool holdData = false, holdCk = false;
+  size_t dataRequests = 0, ckRequests = 0, successes = 0, errors = 0;
+};
+
+BOOST_FIXTURE_TEST_SUITE(TestConsumerRevocation, ConsumerRevocationFixture)
+
+BOOST_AUTO_TEST_CASE(LateContentCannotDecryptAfterInvalidation)
+{
+  holdData = true;
+  consume();
+  advanceClocks(time::milliseconds(10), 5);
+  BOOST_REQUIRE_GT(dataRequests, 0U);
+  consumer->clearCache();
+  holdData = false;
+  producerFace.put(*data.front());
+  BOOST_CHECK_NO_THROW(advanceClocks(time::milliseconds(10), 10));
+  BOOST_CHECK_EQUAL(ckRequests, 0U);
+  BOOST_CHECK_EQUAL(successes, 0U);
+  BOOST_CHECK_EQUAL(errors, 0U);
+  consumer->obtainDecryptionKey();
+  advanceClocks(time::milliseconds(20), 60);
+  BOOST_REQUIRE(consumer->readyForDecryption());
+  consume();
+  advanceClocks(time::milliseconds(20), 60);
+  BOOST_CHECK_EQUAL(successes, 1U);
+  BOOST_CHECK_EQUAL(errors, 0U);
+}
+
+BOOST_AUTO_TEST_CASE(LateCkCannotRefillInvalidatedCache)
+{
+  holdCk = true;
+  consume();
+  advanceClocks(time::milliseconds(10), 5);
+  BOOST_REQUIRE_GT(ckRequests, 0U);
+  consumer->clearCache();
+  holdCk = false;
+  producerFace.put(*ck.front());
+  advanceClocks(time::milliseconds(20), 20);
+  BOOST_CHECK_EQUAL(successes, 0U);
+  BOOST_CHECK_EQUAL(errors, 0U);
+  const auto staleFetchRequests = ckRequests;
+  consumer->obtainDecryptionKey();
+  advanceClocks(time::milliseconds(20), 60);
+  BOOST_REQUIRE(consumer->readyForDecryption());
+  consume();
+  advanceClocks(time::milliseconds(20), 60);
+  BOOST_CHECK_GT(ckRequests, staleFetchRequests);
+  BOOST_CHECK_EQUAL(successes, 1U);
+  BOOST_CHECK_EQUAL(errors, 0U);
+}
+
+BOOST_AUTO_TEST_SUITE_END()
+} // namespace ndn::nacabe::tests
