+BOOST_AUTO_TEST_CASE(InvalidPrivateKeyReportsStandardError)
+{
+  auto& abe = ABESupport::getInstance();
+  for (bool kp : {false, true}) {
+    PublicParams pub;
+    MasterKey master;
+    if (kp) abe.kpInit(pub, master); else abe.cpInit(pub, master);
+    auto cipher = kp ? abe.kpEncrypt(pub, {"attr1"}, Buffer{1, 2, 3})
+                     : abe.cpEncrypt(pub, "attr1", Buffer{1, 2, 3});
+    abe.clearCachedContentKeys();
+    bool standardError = false;
+    try {
+      if (kp) abe.kpDecrypt(pub, PrivateKey{}, cipher);
+      else abe.cpDecrypt(pub, PrivateKey{}, cipher);
+    }
+    catch (const NacAlgoError&) { standardError = true; }
+    catch (...) { /* a non-standard OpenABE enum must not escape the API */ }
+    BOOST_CHECK_MESSAGE(standardError, (kp ? "KP error must be NacAlgoError" : "CP error must be NacAlgoError"));
+    auto key = kp ? abe.kpPrvKeyGen(pub, master, "attr1")
+                  : abe.cpPrvKeyGen(pub, master, {"attr1"});
+    const auto plain = kp ? abe.kpDecrypt(pub, key, cipher) : abe.cpDecrypt(pub, key, cipher);
+    BOOST_CHECK(plain == Buffer({1, 2, 3}));
+  }
+}
