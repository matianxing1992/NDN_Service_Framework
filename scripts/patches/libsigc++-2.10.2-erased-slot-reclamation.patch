 namespace
 {
+// slot_rep intentionally erases the functor type and dispatches destruction
+// through destroy_. Release the resulting raw storage without claiming that
+// its allocation had the smaller, non-virtual base type's size.
+void destroy_slot_rep(sigc::internal::slot_rep* rep)
+{
+#ifdef SIGC_NEW_DELETE_IN_LIBRARY_ONLY
+  delete rep;
+#else
+  rep->~slot_rep();
+  ::operator delete(rep);
+#endif
+}
+
