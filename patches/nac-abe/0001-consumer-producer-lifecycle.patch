+void
+Producer::start()
+{
+  if (m_stopped)
+    NDN_THROW(std::logic_error("Producer cannot be restarted after stop"));
+  if (m_started)
+    return;
+  m_started = true;
+  try {
+    if (!m_dataOwnerKeyName.empty()) {
+      const auto callbacksEnabled = m_callbacksEnabled;
+      m_registeredPrefix = m_face.setInterestFilter(
+        Name(m_cert.getIdentity()).append(SET_POLICY),
+        [this, callbacksEnabled] (auto&&, const auto& interest) {
+          if (callbacksEnabled->load(std::memory_order_acquire))
+            onPolicyInterest(interest);
+        },
+        [] (auto&&...) {
+          NDN_THROW(std::runtime_error("Cannot register the prefix to the local NFD"));
+        });
+      NDN_LOG_DEBUG("Set prefix:" << m_cert.getIdentity());
+    }
+    m_paramFetcher.fetchPublicParams();
+  }
+  catch (...) {
+    m_registeredPrefix.cancel();
+    m_started = false;
+    throw;
+  }
+}
+
+void
+Producer::stop() noexcept
+{
+  if (m_stopped)
+    return;
+  m_stopped = true;
+  m_callbacksEnabled->store(false, std::memory_order_release);
+  m_paramFetcher.stop();
+  m_registeredPrefix.cancel();
+}
 
