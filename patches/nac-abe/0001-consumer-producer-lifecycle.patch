+void
+Consumer::stop() noexcept
+{
+  if (m_stopped)
+    return;
+  m_stopped = true;
+  m_callbacksEnabled->store(false, std::memory_order_release);
+  ++m_cacheGeneration;
+  ++m_dkeyGeneration;
+  m_dkeyFetchInFlight = false;
+  m_dkeyFetchPending = false;
+  m_pendingCallbacks.clear();
+  m_ckInterestsSent.clear();
+  m_paramFetcher.stop();
+  for (auto& item : m_segmentFetchers) {
+    if (item.second)
+      item.second->stop();
+  }
+  m_segmentFetchers.clear();
+  for (auto& item : m_ckEncAesCache)
+    std::fill(item.second.begin(), item.second.end(), 0);
+  m_ckEncAesCache.clear();
+  std::fill(m_keyCache.m_prv.begin(), m_keyCache.m_prv.end(), '\0');
+  m_keyCache.m_prv.clear();
+}
+
+uint64_t
+Consumer::retainFetcher(std::shared_ptr<SegmentFetcher> fetcher)
+{
+  const auto id = ++m_nextFetcherId;
+  m_segmentFetchers.emplace(id, std::move(fetcher));
+  return id;
+}
+
+void
+Consumer::retireFetcher(uint64_t id) noexcept
+{
+  const auto callbacksEnabled = m_callbacksEnabled;
+  try {
+    boost::asio::post(m_face.getIoContext(), [this, callbacksEnabled, id] {
+      if (!callbacksEnabled->load(std::memory_order_acquire))
+        return;
+      m_segmentFetchers.erase(id);
+    });
+  }
+  catch (...) {
+    // Retaining a completed fetcher until stop is safe; destroying it from
+    // its own signal callback could invalidate the emitter while it is active.
+  }
 }
 
