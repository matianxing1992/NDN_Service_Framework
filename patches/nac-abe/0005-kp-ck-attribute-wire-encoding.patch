+BOOST_AUTO_TEST_CASE(ActualKpProducerPreservesAttributesAndDecrypts)
+{
+  auto payload = encryptedPayload();
+  payload.parse();
+  const Name locator(payload.get(tlv::Name));
+  BOOST_REQUIRE(!ck.empty());
+  BOOST_CHECK(locator == ck.front()->getName().getPrefix(-1));
+  BOOST_REQUIRE_EQUAL(locator.size(), producerCert.getIdentity().size() + 4);
+  BOOST_CHECK(producerCert.getIdentity().isPrefixOf(locator));
+  auto attributes = locator[-1];
+  BOOST_REQUIRE_EQUAL(attributes.type(), tlv::GenericNameComponent);
+  BOOST_REQUIRE_GT(attributes.value_size(), 0U);
+  attributes.parse();
+  BOOST_REQUIRE_EQUAL(attributes.elements_size(), 2U);
+  size_t index = 0;
+  for (const auto& attribute : attributes.elements()) {
+    BOOST_CHECK_EQUAL(attribute.type(), TLV_Attribute);
+    const std::string value(reinterpret_cast<const char*>(attribute.value()), attribute.value_size());
+    BOOST_CHECK_EQUAL(value, index++ == 0 ? "attr1" : "attr2");
+  }
+  strictConsume();
+  advanceClocks(time::milliseconds(20), 100);
+  BOOST_CHECK_EQUAL(successes, 1U);
+  BOOST_CHECK_MESSAGE(errors == 0U, (errorReasons.empty() ? "unexpected failure" : errorReasons.front()));
+  BOOST_CHECK_GT(ckRequests, 0U);
+}
+
+BOOST_AUTO_TEST_CASE(ValidKpCipherRejectsSignatureValidWrongIdentityCk)
+{
+  const auto other = addIdentity("/revocation").getDefaultKey().getDefaultCertificate();
+  for (auto& packet : ck) {
+    m_keyChain.sign(*packet, security::signingByCertificate(other));
+    BOOST_REQUIRE(security::verifySignature(*packet, other));
+    BOOST_REQUIRE(!security::verifySignature(*packet, producerCert));
+  }
+  strictConsume();
+  advanceClocks(time::milliseconds(20), 100);
+  BOOST_CHECK_GT(ckRequests, 0U);
+  BOOST_CHECK_EQUAL(successes, 0U);
+  BOOST_CHECK_EQUAL(errors, 1U);
+  BOOST_REQUIRE_EQUAL(errorReasons.size(), 1U);
+  BOOST_CHECK(errorReasons.front().find("authorization") != std::string::npos);
+}
+
+BOOST_AUTO_TEST_SUITE_END()
