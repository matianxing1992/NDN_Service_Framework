name /example/hello/controller/NDNSF/ControllerPolicy/v1

provider-policies
{
    provider-policy
    {
        for /example/hello/provider
        allow
        {
            /HELLO
            /NDNSF/DistributedRepo/Store
            /NDNSF/DistributedRepo/Store/ROLE/artifact-replica-0
            /NDNSF/DistributedRepo/Artifact/v2/STORE
            /NDNSF/DistributedRepo/Artifact/v2/STORE/ROLE/artifact-replica-0
        }
    }
    provider-policy
    {
        for /example/hello/provider/A
        allow
        {
            /HELLO
            /NDNSF/DistributedRepo/Store
            /NDNSF/DistributedRepo/Store/ROLE/artifact-replica-0
            /NDNSF/DistributedRepo/Artifact/v2/STORE
            /NDNSF/DistributedRepo/Artifact/v2/STORE/ROLE/artifact-replica-0
        }
    }
    provider-policy
    {
        for /example/hello/provider/B
        allow
        {
            /HELLO
            /NDNSF/DistributedRepo/Store
            /NDNSF/DistributedRepo/Artifact/v2/STORE
            /NDNSF/DistributedRepo/Store/ROLE/artifact-replica-0
        }
    }
    provider-policy
    {
        for /example/hello/provider/C
        allow
        {
            /HELLO
            /NDNSF/DistributedRepo/Store
            /NDNSF/DistributedRepo/Store/ROLE/artifact-replica-0
        }
    }
}

user-policies
{
    user-policy
    {
        for /example/hello/user
        allow
        {
            /HELLO
            /NDNSF/DistributedRepo/Store
            /NDNSF/DistributedRepo/Artifact/v2/STORE
        }
    }
}
