top = '..'



def build(bld):
    # Explicit public-header allowlist: what is installed is a reviewed decision,
    # not whatever happens to live in include/. Entries leave this list only when
    # their consumers have moved to the unified client (Spec 240 T004).
    public_headers = [
        'ArtifactManifest.hpp',
        'artifact-client-types.hpp',
        'ArtifactTransfer.hpp',
        'ArtifactTypes.hpp',
        'FilesystemArtifactStore.hpp',
        'FilesystemRepoStoreBackend.hpp',
        'LegacyRepoImporter.hpp',
        'PersistentRepoServerConfig.hpp',
        'RepoClient.hpp',
        'repo-client-types.hpp',
        'RepoCore.hpp',
        'RepoEncryptedLargeDataStore.hpp',
        'RepoNode.hpp',
        'RepoPacketServer.hpp',
        'RepoProtocol.hpp',
        'RepoSourceProvider.hpp',
        'RepoStoreBackend.hpp',
        'RepoTypes.hpp',
    ]
    bld.install_files('${INCLUDEDIR}/ndnsf-distributed-repo',
                      [bld.path.find_node('include/ndnsf-distributed-repo/' + name)
                       for name in public_headers])
    repo_sources = [
        'src/ArtifactManifest.cpp',
        'src/ArtifactRepositoryApi.cpp',
        'src/ArtifactTransfer.cpp',
        'src/ArtifactTypes.cpp',
        'src/face-data-reference-fetcher.cpp',
        'src/LegacyRepoImporter.cpp',
        'src/PersistentRepoServerConfig.cpp',
        'src/backends/FilesystemArtifactStore.cpp',
        'src/backends/FilesystemRepoStoreBackend.cpp',
        'src/RepoClient.cpp',
        'src/RepoCore.cpp',
        'src/RepoNode.cpp',
        'src/RepoPacketServer.cpp',
        'src/RepoProtocol.cpp',
        'src/RepoStoreBackend.cpp',
        'src/RepoTypes.cpp',
    ]

    bld.stlib(name='ndnsf-distributed-repo',
              target='ndnsf-distributed-repo',
              source=repo_sources,
              cxxflags=['-fPIC'],
              includes=['include', '..'],
              export_includes=['include'],
              use='ndn-service-framework NDN_SVS NDN_CXX BOOST NAC-ABE NDNSD OPENSSL sqlite3 DL',
              install_path='${LIBDIR}')

    if (bld.env.WITH_REPO_PYTHON or
        'spec201-repo-python-binding' in (bld.targets or '').split(',')):
        import os
        import sys
        import sysconfig
        import pybind11
        # Debian keeps the interpreter's own tree under dist-packages; prefer the
        # directory the target installation actually uses before falling back to
        # the interpreter's purelib for this prefix.
        python_site = sysconfig.get_path(
            'purelib', vars={'base': bld.env.PREFIX, 'platbase': bld.env.PREFIX})
        dist_site = (bld.env.PREFIX + '/lib/python' +
                     '.'.join(map(str, sys.version_info[:2])) + '/dist-packages')
        if os.path.isdir(dist_site):
            python_site = dist_site
        binding_env = bld.env.derive()
        binding_env.cxxshlib_PATTERN = '%s' + sysconfig.get_config_var('EXT_SUFFIX')
        bld.shlib(name='spec201-repo-python-binding',
                  target='../spec201-repo-python/_py_repoclient',
                  env=binding_env,
                  source=['pythonWrapper/src/py_repoclient/_py_repoclient.cpp',
                          'pythonWrapper/src/py_repoclient/artifact_repository_bindings.cpp',
                          'pythonWrapper/src/py_repoclient/unified_client_bindings.cpp'],
                  includes=['include', '..', '../ndn-service-framework',
                            sysconfig.get_path('include'), pybind11.get_include()],
                  use='ndnsf-distributed-repo ndn-service-framework NDN_SVS NDN_CXX BOOST NAC-ABE NDNSD OPENSSL sqlite3 DL',
                  cxxflags=['-fPIC', '-O0', '-g0'],
                  rpath=[bld.bldnode.abspath()],
                  install_path=python_site + '/py_repoclient')
        if bld.env.WITH_REPO_PYTHON:
            bld.install_files(
                python_site + '/py_repoclient',
                bld.path.ant_glob('pythonWrapper/py_repoclient/*.py'))

    bld.program(name='NDNSF_RepoPacketServer',
                target='NDNSF_RepoPacketServer',
                source=['src/RepoPacketServerMain.cpp'],
                includes=['include', '..'],
                use='ndnsf-distributed-repo ndn-service-framework NDN_SVS NDN_CXX BOOST NAC-ABE NDNSD OPENSSL sqlite3 DL',
                rpath=[bld.env.LIBDIR],
                install_path='${BINDIR}')
    bld.program(name='ndnsf-repo-owner-delete',
                target='ndnsf-repo-owner-delete',
                source=['apps/repo-owner-delete.cpp'],
                rpath=[bld.env.LIBDIR],
                includes=['include', '..'],
                use='ndnsf-distributed-repo ndn-service-framework NDN_CXX NDN_SVS BOOST NAC-ABE NDNSD OPENSSL sqlite3 DL',
                install_path='${BINDIR}')
    bld.program(name='DistributedRepoServer',
                target='DistributedRepoServer',
                source=['apps/DistributedRepoServer.cpp'],
                rpath=[bld.env.LIBDIR],
                includes=['include', '..'],
                use='ndnsf-distributed-repo ndn-service-framework NDN_CXX NDN_SVS BOOST NAC-ABE NDNSD OPENSSL sqlite3 DL',
                install_path='${BINDIR}')

    bld.program(name='ndnsf-repo-import',
                target='ndnsf-repo-import',
                source=['apps/LegacyRepoImport.cpp'],
                includes=['include', '..'],
                use='ndnsf-distributed-repo ndn-service-framework NDN_CXX NDN_SVS BOOST NAC-ABE NDNSD OPENSSL sqlite3 DL',
                install_path=None)
    bld.program(name='DistributedRepoSmoke',
                target='DistributedRepoSmoke',
                source=['examples/DistributedRepoSmoke.cpp'],
                includes=['include', '..'],
                use='ndnsf-distributed-repo ndn-service-framework NDN_SVS NDN_CXX BOOST NAC-ABE NDNSD OPENSSL sqlite3 DL',
                rpath=[bld.bldnode.abspath()],
                install_path=None)

    bld.program(name='DistributedRepoTieredCacheTest',
                target='DistributedRepoTieredCacheTest',
                source=['examples/DistributedRepoTieredCacheTest.cpp'],
                includes=['include', '..'],
                use='ndnsf-distributed-repo ndn-service-framework NDN_SVS NDN_CXX BOOST NAC-ABE NDNSD OPENSSL sqlite3 DL',
                install_path=None)

    bld.program(name='DistributedRepoExactPacketTest',
                target='DistributedRepoExactPacketTest',
                source=['examples/DistributedRepoExactPacketTest.cpp'],
                includes=['include', '..'],
                use='ndnsf-distributed-repo ndn-service-framework NDN_SVS NDN_CXX BOOST NAC-ABE NDNSD OPENSSL sqlite3 DL',
                rpath=[bld.env.LIBDIR],
                install_path='${BINDIR}' if bld.env.INSTALL_EXPERIMENT_FIXTURES else None)

    bld.program(name='DistributedRepoHaTest',
                target='DistributedRepoHaTest',
                source=['examples/DistributedRepoHaTest.cpp'],
                includes=['include', '..'],
                use='ndnsf-distributed-repo ndn-service-framework NDN_SVS NDN_CXX BOOST NAC-ABE NDNSD OPENSSL sqlite3 DL',
                install_path=None)

    bld.program(name='RepoStoredReadRestart',
                target='RepoStoredReadRestart',
                source=['examples/RepoStoredReadRestart.cpp'],
                includes=['include', '..'],
                use='ndnsf-distributed-repo ndn-service-framework NDN_SVS NDN_CXX BOOST NAC-ABE NDNSD OPENSSL sqlite3 DL',
                install_path=None)

    bld.program(name='RepoObjectKeyProbe',
                target='RepoObjectKeyProbe',
                source=['examples/RepoObjectKeyProbe.cpp'],
                includes=['include', '..'],
                use='ndnsf-distributed-repo ndn-service-framework NDN_SVS NDN_CXX BOOST NAC-ABE NDNSD OPENSSL sqlite3 DL',
                install_path=None)

    bld.program(name='Spec188RepoFileBackend',
                target='Spec188RepoFileBackend',
                source=['examples/Spec188RepoFileBackend.cpp'],
                includes=['include', '..'],
                use='ndnsf-distributed-repo ndn-service-framework NDN_SVS NDN_CXX BOOST NAC-ABE NDNSD OPENSSL sqlite3 DL',
                install_path=None)

    bld.program(name='Spec188RepoMemoryBudget',
                target='Spec188RepoMemoryBudget',
                source=['examples/Spec188RepoMemoryBudget.cpp'],
                includes=['include', '..'],
                use='ndnsf-distributed-repo ndn-service-framework NDN_SVS NDN_CXX BOOST NAC-ABE NDNSD OPENSSL sqlite3 DL',
                install_path=None)

    bld.program(name='Spec188RepoRangeTransfer',
                target='Spec188RepoRangeTransfer',
                source=['examples/Spec188RepoRangeTransfer.cpp'],
                includes=['include', '..'],
                use='ndnsf-distributed-repo ndn-service-framework NDN_SVS NDN_CXX BOOST NAC-ABE NDNSD OPENSSL sqlite3 DL',
                install_path=None)
