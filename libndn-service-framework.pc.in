prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: libndn-service-framework
Description: NDN SERVICE Framework
Version: @VERSION@
Requires: libndn-svs >= 0.1.0
Libs: -L${libdir} @EXTRA_LINKFLAGS@ @EXTRA_LDFLAGS@ -lndn-service-framework @EXTRA_LIBS@ @EXTRA_FRAMEWORKS@
Cflags: -I${includedir} -I${includedir}/ndn-service-framework @EXTRA_CXXFLAGS@ @EXTRA_INCLUDES@
