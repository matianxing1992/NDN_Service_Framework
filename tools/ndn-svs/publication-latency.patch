+/* -*- Mode: C++; c-file-style: "gnu"; indent-tabs-mode:nil -*- */
+#pragma once
+
+#include <ndn-cxx/name.hpp>
+#include <ndn-cxx/util/regex.hpp>
+
+namespace ndn::svs::detail {
+
+// Private optimization for the four existing NDNSF subscriptions. Match Name
+// components, not URI substrings: typed components and escaped values differ.
+// These subscriptions consume only the boolean result, never regex captures.
+inline bool
+matchPublicationSubscription(Regex& regex, const Name& name)
+{
+  struct LiteralPair
+  {
+    LiteralPair(const char* expr, const char* kind)
+      : expression(expr)
+      , components(Name("/NDNSF").append(kind))
+      , literalUris(components[0].toUri() == "NDNSF" &&
+                    components[1].toUri() == kind)
+    {
+    }
+    const char* expression;
+    Name components;
+    bool literalUris;
+  };
+  static const LiteralPair pairs[] = {
+    {"^(<>*)<NDNSF><ACK>(<>*)$", "ACK"},
+    {"^(<>*)<NDNSF><RESPONSE>(<>*)$", "RESPONSE"},
+    {"^(<>*)<NDNSF><EVENT>(<>*)$", "EVENT"},
+    {"^(<>*)<NDNSF><COLLAB>(<>*)$", "COLLAB"},
+  };
+  for (const auto& pair : pairs) {
+    if (regex.getExpr() != pair.expression)
+      continue;
+    // RegexComponentMatcher uses toUri(), including ndn-cxx's cached URI
+    // formatting policy. Canonical generic URIs carry "8=", so retain Regex
+    // whenever the actual renderer does not produce these literal strings.
+    if (!pair.literalUris)
+      return regex.match(name);
+    for (size_t i = 1; i < name.size(); ++i) {
+      if (name[i - 1] == pair.components[0] && name[i] == pair.components[1])
+        return true;
+    }
+    return false;
+  }
+  return regex.match(name);
+}
+
+} // namespace ndn::svs::detail
