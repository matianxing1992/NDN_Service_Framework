+  {
+  public:
+    void
+    validate(const Data& data,
+             const security::DataValidationSuccessCallback& success,
+             const security::DataValidationFailureCallback& failure) override
+    {
+      ++calls;
+      if (rejectLast && data.getName()[-1].isSegment() &&
+          data.getName()[-1].toSegment() == 1) {
+        failure(data, ValidationError(1, "injected last-segment validation failure"));
+      }
+      else {
+        success(data);
+      }
+    }
+
+    bool rejectLast = true;
+    size_t calls = 0;
+  };
+
+  DummyClientFace face;
+  KeyChain keyChain("pib-memory:fetch-segment-complete", "tpm-memory:fetch-segment-complete");
+  keyChain.createIdentity("/fetch-segment-complete");
+  SecurityOptions security(keyChain);
+  auto validator = std::make_shared<SegmentValidator>();
+  security.encapsulatedDataValidator = validator;
+  SVSPubSubOptions opts;
+  opts.useTimestamp = false;
+  SVSPubSub pubsub("/sync", "/local", face, [] (const auto&) {}, opts, security);
+  const SVSPubSub::PublicationKey publication("/peer", 700, 1);
+  const auto prefix = pubsub.getSVSync().getDataName("/peer", 700, 1);
+  const auto payload = makePayload(12);
+  size_t packetDeliveries = 0;
+  size_t blobDeliveries = 0;
+  pubsub.subscribe("/app", [&] (const SVSPubSub::SubscriptionData&) {
+    ++packetDeliveries;
+    BOOST_CHECK(!pubsub.hasPiggyDeliveredPublication(publication));
+  }, true);
+  pubsub.subscribe("/app", [&] (const SVSPubSub::SubscriptionData& data) {
+    ++blobDeliveries;
+    BOOST_CHECK_EQUAL_COLLECTIONS(data.data.begin(), data.data.end(),
+                                  payload.begin(), payload.end());
+    BOOST_CHECK(pubsub.hasPiggyDeliveredPublication(publication));
+    BOOST_CHECK(!pubsub.processMapping("/peer", 700, 1));
+  });
+  pubsub.insertMapping("/peer", 700, 1, "/app/item", {});
+  std::vector<Data> packets;
+  for (size_t segment = 0; segment < 2; ++segment) {
+    Data outer(Name(prefix).appendVersion(0).appendSegment(segment));
+    outer.setContent(makeInnerSegment(keyChain, "/app/item", segment, 1,
+                                      make_span(payload.data() + 6 * segment, 6)));
+    outer.setContentType(ndn::tlv::Data);
+    outer.setFinalBlock(name::Component::fromSegment(1));
+    outer.setFreshnessPeriod(1_s);
+    keyChain.sign(outer);
+    packets.push_back(std::move(outer));
+  }
+
+  for (const bool rejectLast : {true, false}) {
+    validator->rejectLast = rejectLast;
+    face.sentInterests.clear();
+    BOOST_REQUIRE(pubsub.processMapping("/peer", 700, 1));
+    pubsub.onSyncData(packets[0], publication);
+    auto hasInterest = [&] (const Name& name) {
+      return std::any_of(face.sentInterests.begin(), face.sentInterests.end(),
+                         [&] (const Interest& interest) { return interest.getName() == name; });
+    };
+    runIoUntil(face, [&] { return hasInterest(prefix); });
+    BOOST_REQUIRE(hasInterest(prefix));
+    face.receive(packets[0]);
+    runIoUntil(face, [&] { return hasInterest(packets[1].getName()); });
+    BOOST_REQUIRE(hasInterest(packets[1].getName()));
+    BOOST_CHECK(!pubsub.hasPiggyDeliveredPublication(publication));
+    BOOST_CHECK_EQUAL(blobDeliveries, 0);
+    face.receive(packets[1]);
+    runIoUntil(face, [&] { return !pubsub.hasFetchForTest(publication); });
+    BOOST_REQUIRE(!pubsub.hasFetchForTest(publication));
+    BOOST_CHECK_EQUAL(pubsub.hasPiggyDeliveredPublication(publication), !rejectLast);
+    BOOST_CHECK_EQUAL(blobDeliveries, rejectLast ? 0 : 1);
+  }
+  BOOST_CHECK_EQUAL(packetDeliveries, 2);
+  BOOST_CHECK_EQUAL(validator->calls, 6);
+  BOOST_CHECK(!pubsub.processMapping("/peer", 700, 1));
+}
