                        bld.path.parent.find_node('NDNSF-UAV-APP/tracking/UavTrackingSession.cpp')],
                includes=['..', '../ndn-service-framework'],
                use='ndn-service-framework NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL DL',
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Real validated Core collaboration ingress composed with native person admission.
    bld.program(target='../uav-person-admission-tests', name='uav-person-admission-tests',
                source=[bld.path.find_node('main.cpp'),
                        bld.path.find_node('integration-tests/uav-person-admission.t.cpp'),
                        bld.path.find_node('integration-tests/ndnsf-integration-fixture.cpp'),
                        bld.path.parent.find_node('NDNSF-UAV-APP/shared/UavProtocol.cpp'),
                        bld.path.parent.find_node('NDNSF-UAV-APP/shared/UavTrackingResultVerifier.cpp'),
                        bld.path.parent.find_node('NDNSF-UAV-APP/shared/uav-person-tracking-profile.cpp'),
                        bld.path.parent.find_node('NDNSF-UAV-APP/shared/uav-person-computation.cpp'),
                        bld.path.parent.find_node('NDNSF-UAV-APP/shared/uav-person-tracking.cpp'),
                        bld.path.parent.find_node('NDNSF-UAV-APP/shared/uav-byte-track-state.cpp'),
                        bld.path.parent.find_node('NDNSF-UAV-APP/shared/UavTrackingWorkerTransaction.cpp'),
