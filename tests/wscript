    # Native frozen computation inventory and maintained signed request bindings.
    bld.program(target='../uav-person-computation-tests', name='uav-person-computation-tests',
                source=[bld.path.find_node('main.cpp'),
                        bld.path.find_node('unit-tests/uav-person-computation.t.cpp'),
