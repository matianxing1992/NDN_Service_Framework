                includes=['..', '../ndn-service-framework'],
                use='ndn-service-framework NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL DL',
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec224 T001 step-contract regressions link the production DI library so
    # the sealed plan types, their wire round-trip and the placement-facing
    # step template are the same objects the Provider loads.
    # ONNXRUNTIME is required, not optional: the shard-math case compares the
    # sliced MatMulNBits results against the unsplit one, so the test must run
    # real ORT kernels rather than reimplement the arithmetic it is checking.
    # The step-flow cases drive the production ProviderRoleWorker, so this target
    # also links the DI integration closure those paths need.
    # The two-Provider case needs the integration environment, so the fixture is
    # linked here rather than duplicated: two Providers exchanging partials over
    # Named Data cannot be simulated with a single-process fake, and a second
    # test-only transport would prove nothing about the production one.
    bld.program(target='../tp-tests', name='tp-tests',
                source=di_fixture_local_sources +
                       [bld.path.find_node('unit-tests/di-native-tensor-parallel.t.cpp')],
                includes=framework_includes,
                use=di_integration_use + 'ndnsf-distributed-inference ndn-service-framework ' +
                    framework_use + ' ONNXRUNTIME ' + di_fixture_objects,
                defines=['HAVE_TESTS'], cxxflags=['-fPIC', '-O0', '-g0'],
                linkflags=['-Wl,--no-relax'],
                # No build-tree RPATH on this target: it is the one installed for an out-of-tree
                # consumer, and a RPATH naming this checkout does not exist on another machine. The
                # installed binary resolves its libraries through the prefix's pkg-config/LD path,
                # which the runner sets; the source-mode build resolves them through
                # LD_LIBRARY_PATH, which run-checks.py sets only in source mode.
                install_path='${PREFIX}/libexec/ndnsf-tests')
    # C10 asks for one bounded asan-ubsan card over the real C++ selector once the local tensor
    # representation exists. Only the local-handoff cases run there: the card is about ownership
    # and lifetime, so a whole-suite run under instrumentation would cost hours to cover paths
    # that never touch a local value. Compile the worker itself with instrumentation so the
    # direct-consume and wait/resume cases also check production worker code.
    bld.program(target='../tp-tests-asan', name='tp-tests-asan',
                source=[bld.path.find_node('main.cpp'),
                        bld.path.find_node('unit-tests/di-native-tensor-parallel.t.cpp'),
                        bld.path.find_node('integration-tests/ndnsf-integration-fixture.cpp'),
                        bld.srcnode.find_node('NDNSF-DistributedInference/cpp/ndnsf-di/'
                                              'ProviderRoleWorker.cpp')],
                includes=framework_includes,
                use=di_integration_use + 'ndnsf-distributed-inference ndn-service-framework ' +
                    framework_use + ' ONNXRUNTIME',
                defines=['HAVE_TESTS'],
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-omit-frame-pointer',
                          '-fsanitize=address,undefined'],
                linkflags=['-Wl,--no-relax', '-fsanitize=address,undefined'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    bld.program(target='../spec242-hybrid-cut-tests', name='spec242-hybrid-cut-tests',
                source=[bld.path.find_node('main.cpp'),
                        bld.path.find_node('unit-tests/di-hybrid-cut.t.cpp'),
                        bld.path.find_node('unit-tests/distributed-inference-native-preparation-context.t.cpp')],
                includes=framework_includes,
                use=di_integration_use + 'ndnsf-distributed-inference ndn-service-framework ' +
                    framework_use + ' ONNXRUNTIME',
                defines=['HAVE_TESTS'], cxxflags=['-fPIC', '-O0', '-g0'],
                linkflags=['-Wl,--no-relax'], rpath=[bld.bldnode.abspath()], install_path=None)

    # Declare resources after native targets: Waf counts install generators in the
    # per-directory index, which must not move native object paths when a fixture is added.
    # The installed check runner: one entry point, one roster, one fixture tree, all under the
    # prefix. An installed consumer must not need the source tree, so the roster and the fixtures
    # travel with the binary and the runner resolves them from its own prefix.
    # `share` is spelled out because this tree does not define a DATADIR variable, and inventing
    # one here would disagree with the installer's own manifest, which records absolute paths.
    # Fixture preparation helper: print the canonical identity a planner will
    # compute for one ONNX file, so a tracked driver never re-implements it.
    bld.program(target='../native-source-inspect', name='native-source-inspect',
                source=[bld.path.find_node('standalone/native-source-inspect.cpp'),
                        bld.path.find_node('standalone/native-yolo-tp-checkpoints.cpp')] +
                       di_integration_sources,
                includes=framework_includes,
                use='ndnsf-distributed-inference ' + di_integration_use + ' ONNXRUNTIME',
                defines=['HAVE_TESTS'], cxxflags=['-fPIC', '-O0', '-g0'],
                linkflags=['-Wl,--no-relax', '-Wl,-rpath,$ORIGIN',
                           '-Wl,-rpath,$ORIGIN/../../lib'],
                install_path='${PREFIX}/libexec/ndnsf-tests'
                    if bld.env.INSTALL_EXPERIMENT_FIXTURES else None)

    tests_share = '${PREFIX}/share/ndnsf/tests'
    bld.install_files(tests_share, 'run-checks.py', chmod=0o755)
    driver_names = (['run-spec182-native-grant-process.py',
                     'run-spec182-native-unary-process.py',
                     'run-spec182-native-stream-process.py',
                     'run-spec261-source-full-process.py',
                     'run-spec261-source-component-process.py',
                     'run-spec261-source-hybrid-process.py',
                     'run-spec261-source-bypass-process.py',
                     'run-spec261-yolo-full-process.py',
                     'run-spec261-yolo-component-process.py',
                     'run-spec261-yolo-hybrid-process.py',
                     'run-spec261-twoprovider-process.py',
                     'run-spec261-yolo-twoprovider-process.py', 'di_native_fixture.py']
                    if 'di' in bld.env.NDNSF_COMPONENTS else [])
    bld.env.NDNSF_TEST_DRIVER_FILES = driver_names
    if driver_names:
        bld.install_files(tests_share + '/standalone',
                          [bld.path.find_node('standalone/' + name) for name in driver_names])
    # The contract names `PREFIX/bin/ndnsf-checks` as the canonical entry point; the runner above is
    # its implementation, so an operator path and a source path cannot diverge.
    bld.install_files('${PREFIX}/bin', 'ndnsf-checks', chmod=0o755)
    fixtures_root = bld.path.find_node('fixtures')
    fixtures = bld.path.ant_glob('fixtures/**/*',
                               excl=['fixtures/**/*.pyc', 'fixtures/**/__pycache__/**'])
    bld.env.NDNSF_TEST_FIXTURE_FILES = sorted(str(fixture.path_from(fixtures_root))
                                            for fixture in fixtures)
    for fixture in fixtures:
        bld.install_as(tests_share + '/fixtures/' +
                       str(fixture.path_from(fixtures_root)), fixture)

    component_tools = runpy.run_path(bld.path.find_node('build-components.py').abspath())
    roster = json.loads(bld.path.find_node('check-profiles.json').read())
    component_tools['apply_component_scope'](bld, roster)
    bld(name='ndnsf-test-roster', rule=component_tools['write_roster'],
        source=bld.srcnode.find_node('tests/check-profiles.json'), target='check-profiles.json',
        vars=['NDNSF_COMPONENTS', 'NDNSF_TEST_FIXTURE_FILES', 'NDNSF_TEST_DRIVER_FILES'],
        install_path=tests_share)

    # Keep existing generator indices so introducing reuse doesn't invalidate later targets.
    bld.objects(name=focused_framework_objects, source=framework_sources,
                includes=framework_includes, use=framework_use, defines=['HAVE_TESTS'],
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'])
    if repo_enabled:
        di_fixture_defines = ['HAVE_TESTS',
                              'NDNSF_TEST_SOURCE_DIR="%s"' % bld.srcnode.abspath(),
                              'NDNSF_TEST_BINARY_DIR="%s"' % bld.bldnode.abspath()]
        bld.objects(name='di-test-fixture-objects', source=di_fixture_sources,
                    includes=framework_includes, use=di_fixture_use, defines=di_fixture_defines,
                    cxxflags=['-fPIC', '-O0', '-g0'])
