# -*- Mode: python; py-indent-offset: 4; indent-tabs-mode: nil; coding: utf-8; -*-

top = '..'

import os

def build(bld):
    bld.program(target='../spec181-exact-data-wire',
                name='spec181-exact-data-wire',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('integration-tests/spec181-exact-data-wire.t.cpp'),
                        bld.path.find_node('integration-tests/ndnsf-integration-fixture.cpp')],
                includes=['..', '../ndn-service-framework'],
                use='ndn-service-framework NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL DL',
                cxxflags=['-fPIC'], linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Reuse framework contract tests against the production shared library.
    # Keep source-closure diagnostics independent of DI adapter build inputs.
    bld.program(target='../spec181-framework-closure',
                name='spec181-framework-closure',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('unit-tests/invocation-stream-lifecycle.t.cpp'),
                        bld.path.find_node('unit-tests/opaque-selection-lifecycle.t.cpp')],
                includes=['..', '../ndn-service-framework'],
                use='ndn-service-framework NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL DL',
                cxxflags=['-fPIC'], linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    grant_sources = [bld.path.find_node('integration-tests/ndnsf-di-protected-grant.t.cpp')] + bld.path.parent.ant_glob([
        'NDNSF-DistributedInference/cpp/ndnsf-di/NativeProtectedGrantCredentials.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/NativeProtectedGrantTransport.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/NativeGrantVerifier.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/ProtectedRuntime.cpp',
    ])
    for target, sanitize in [('spec181-native-grant-integration', False),
                             ('spec181-native-grant-asan', True)]:
        flags = ['-fsanitize=address', '-fno-omit-frame-pointer'] if sanitize else []
        bld.program(target='../' + target, name=target, source=grant_sources,
                    includes=['..', '../ndn-service-framework'],
                    use='NDN_CXX BOOST OPENSSL', cxxflags=flags,
                    linkflags=flags, rpath=[bld.bldnode.abspath()], install_path=None)

    # Focused production-entry parity; use the configured native dependency
    # closure instead of maintaining a second hand-written compiler command.
    bld.program(target='../spec181-assembly-parity',
                name='spec181-assembly-parity',
                source=[bld.path.find_node('fixtures/spec181/assembly-parity-driver.cpp')] +
                       bld.path.parent.ant_glob([
                           'NDNSF-DistributedInference/cpp/ndnsf-di/NativeCanonicalOnnxAssembler.cpp',
                           'NDNSF-DistributedInference/cpp/adapters/onnx/NativeOnnxRecipeAssembler.cpp',
                           'NDNSF-DistributedInference/cpp/adapters/onnx/NativeOnnxAssemblyWorker.cpp',
                           'NDNSF-DistributedInference/cpp/ndnsf-di/ProtectedRuntime.cpp',
                           'NDNSF-DistributedInference/cpp/ndnsf-di/NativeGrantVerifier.cpp',
                           'NDNSF-DistributedInference/cpp/ndnsf-di/NativeProtectedArtifactStore.cpp',
                       ]),
                includes=['..', '../ndn-service-framework',
                          '../NDNSF-DistributedInference/cpp/adapters/onnx'],
                use='ndn-service-framework NDN_CXX NDN_SVS PROTOBUF ONNX ONNXRUNTIME NAC-ABE NDNSD BOOST OPENSSL DL',
                rpath=[bld.bldnode.abspath()],
                install_path=None)

    framework_sources = bld.path.parent.ant_glob([
        'ndn-service-framework/NDNSFMessages.cpp',
        'ndn-service-framework/InvocationStream.cpp',
        'ndn-service-framework/CertificatePublisher.cpp',
        'ndn-service-framework/ConfigManager.cpp',
        'ndn-service-framework/PolicyParser.cpp',
        'ndn-service-framework/CertificateBootstrap.cpp',
        'ndn-service-framework/ServiceProvider.cpp',
        'ndn-service-framework/ServiceUser.cpp',
        'ndn-service-framework/ServiceController.cpp',
        'ndn-service-framework/RuntimeStatusStore.cpp',
        'ndn-service-framework/Stream.cpp',
        'ndn-service-framework/StreamFacade.cpp',
        'ndn-service-framework/HybridMessageCrypto.cpp',
        'ndn-service-framework/RequestConfidentiality.cpp',
        'ndn-service-framework/ExecutionLease.cpp',
        'ndn-service-framework/NetworkTelemetry.cpp',
        'ndn-service-framework/TimelineTrace.cpp',
        'ndn-service-framework/GenericSelectionTxnStore.cpp',
        'ndn-service-framework/ControllerVersion.cpp',
        'ndn-service-framework/PolicyStatus.cpp',
        'ndn-service-framework/ControllerGenerationStore.cpp',
        'ndn-service-framework/RevocationState.cpp',
        'ndn-service-framework/PolicyRefreshCoordinator.cpp',
        'ndn-service-framework/OperationRuntime.cpp',
        'ndn-service-framework/common.cpp',
        'ndn-service-framework/utils.cpp',
    ])
    framework_includes = ['..', '../ndn-service-framework',
                          '../NDNSF-DistributedRepo/include',
                          '../NDNSF-DistributedInference/cpp/adapters/onnx']
    # NAC-ABE's installed algorithm headers use the historical quoted
    # include "common.hpp".  The package export names only its parent include
    # directory, so add the nested directory explicitly; otherwise the quote
    # can resolve to an unrelated common.hpp (or leave test-only members
    # private) when compiling the integration target.
    framework_includes += [os.path.join(path, 'nac-abe')
                           for path in getattr(bld.env, 'INCLUDES_NAC_ABE', [])
                           if os.path.isdir(os.path.join(path, 'nac-abe'))]
    framework_use = 'NDN_CXX NDN_SVS PROTOBUF ONNX NAC-ABE NDNSD BOOST OPENSSL DL TOKENIZER_BRIDGE'

    # Link a clean external-style consumer against the installable DI library
    # boundary.  The program performs no network work; it only proves that the
    # public native header and shared-library symbols resolve together.
    bld.program(target='../spec182-installed-consumer',
                name='spec182-installed-consumer',
                source=[bld.path.find_node('standalone/spec182-installed-consumer.cpp')],
                includes=['..', '../ndn-service-framework'],
                use='ndnsf-distributed-inference ndn-service-framework ' + framework_use,
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec185 B0 consumer: only the installed-style public umbrellas and the
    # ONNX runner compatibility header are included.  The source-tree include
    # path is used solely to compile this in-tree executable; the external
    # install-prefix check in the batch evidence repeats the same source with
    # pkg-config and no repository -I path.
    bld.program(target='../spec185-installed-consumer',
                name='spec185-installed-consumer',
                source=[bld.path.find_node('installed-api/spec185-installed-consumer.cpp')],
                includes=['..', '../ndn-service-framework'],
                use='ndnsf-distributed-inference ndn-service-framework ' + framework_use,
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec185 T001 standalone Runtime.hpp consumer.  The external script
    # repeats this source against an install prefix with pkg-config and no
    # source-tree include path, proving the stable Runtime symbol boundary.
    bld.program(target='../spec185-runtime-consumer',
                name='spec185-runtime-consumer',
                source=[bld.path.find_node('installed-api/runtime-api-consumer.cpp')],
                includes=['..', '../ndn-service-framework'],
                use='ndnsf-distributed-inference ndn-service-framework ' + framework_use,
                cxxflags=['-fPIC'], linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec185 B0C Core-only operation selector.  It links only the framework
    # library so the ownership boundary cannot be satisfied by DI/Python.
    bld.program(target='../spec185-core-operation',
                name='spec185-core-operation',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('unit-tests/core-operation-runtime.t.cpp')],
                includes=['..', '../ndn-service-framework'],
                use='ndn-service-framework NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL DL',
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # In-tree smoke consumer; PO-C1's installed-boundary consumer is compiled
    # by tests/installed-api/run-spec185-core-operation-consumer.sh with only
    # libndn-service-framework.pc from an install prefix.
    bld.program(target='../spec185-core-operation-consumer',
                name='spec185-core-operation-consumer',
                source=[bld.path.find_node('installed-api/core-operation-consumer.cpp')],
                includes=['..', '../ndn-service-framework'],
                use='ndn-service-framework NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL DL',
                cxxflags=['-fPIC'], linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec185 B1 Runtime configuration boundary.  The selector validates the
    # native requester-v1 schema, trust-domain/model-key freeze, resource
    # limits, and deferred source loading before T002 adds shutdown owners.
    bld.program(target='../spec185-runtime',
                name='spec185-runtime',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('unit-tests/di-runtime.t.cpp')],
                includes=['..', '../ndn-service-framework', '../NDNSF-DistributedRepo/include'],
                use='ndn-service-framework ndnsf-distributed-inference ndnsf-distributed-repo NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL DL',
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec185 B2E cooperative extension registry and control contract.
    bld.program(target='../spec185-extension-registry',
                name='spec185-extension-registry',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('unit-tests/di-extension-contract.t.cpp'),
                        bld.path.find_node('installed-api/extension-header-consumer.cpp')],
                includes=['..', '../ndn-service-framework'],
                use='ndn-service-framework ndnsf-distributed-inference NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL DL',
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec185 B2 verified package preparation.  The selector exercises the
    # native source/content oracle and immutable Package boundary; shared
    # single-flight waiters and refresh generations are owned by T004.
    bld.program(target='../spec185-preparation',
                name='spec185-preparation',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('unit-tests/di-preparation.t.cpp'),
                        bld.path.find_node('unit-tests/di-runtime.t.cpp')],
                includes=['..', '../ndn-service-framework'],
                use='ndn-service-framework ndnsf-distributed-inference NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL DL',
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # T004 has an explicit selector/binary so cache, waiter, lease, and
    # Core-worker boundary evidence cannot be mistaken for the T003 cold path.
    bld.program(target='../spec185-preparation-t004',
                name='spec185-preparation-t004',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('unit-tests/di-preparation.t.cpp'),
                        bld.path.find_node('unit-tests/di-runtime.t.cpp'),
                        bld.path.find_node('unit-tests/core-operation-runtime.t.cpp')],
                includes=['..', '../ndn-service-framework'],
                use='ndn-service-framework ndnsf-distributed-inference NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL DL',
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec188 B188-3 immutable canonical publication cache.  The selector
    # drives the production publisher through its native transport seam and
    # keeps source verification/publication counters independent from request
    # orchestration.
    bld.program(target='../spec188-model-preparation-publication',
                name='spec188-model-preparation-publication',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('integration-tests/spec188-model-preparation-publication.t.cpp')],
                includes=['..', '../ndn-service-framework'],
                use='ndn-service-framework ndnsf-distributed-inference NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL DL',
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec188 B188-4 request projection selector.  It parses the exact native
    # envelope and checks that model references remain distinct from input
    # DataRefs without copying model payload bytes into the request.
    bld.program(target='../spec188-prepared-request-projection',
                name='spec188-prepared-request-projection',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('integration-tests/spec188-prepared-request-projection.t.cpp')],
                includes=['..', '../ndn-service-framework'],
                use='ndn-service-framework ndnsf-distributed-inference NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL DL',
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec189 T004 wire-only request oracle.  This is deliberately separate
    # from the historical Spec188 projection selector so its oversized and
    # arbitrary-model-reference negatives have an independent source/build
    # identity.  It does not claim PreparedModel/Repo runtime reuse.
    bld.program(target='../spec189-request-wire',
                name='spec189-request-wire',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('integration-tests/spec189-request-reference.t.cpp')],
                includes=['..', '../ndn-service-framework'],
                use='ndn-service-framework ndnsf-distributed-inference NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL DL',
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec188 B188-4 bounded file-backed large-data serving.  The selector
    # exercises the production ServiceUser interest path, exact signed
    # segments, retransmission window and publication-file cleanup.
    bld.program(target='../spec188-bounded-large-data-publisher',
                name='spec188-bounded-large-data-publisher',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('integration-tests/spec188-bounded-large-data-publisher.t.cpp')],
                includes=['..', '../ndn-service-framework'],
                use='ndn-service-framework ndnsf-distributed-inference NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL DL',
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec182 worker-protocol test tools (T006-C).  Deliberately-misbehaving
    # worker children spawned through the same OA02 transport for the crash /
    # cancel / incomplete subprocess cases; never installed and never
    # referenced by production code.  Each tool is a dependency-free libc
    # binary so it stays isolated from the framework in its own process group.
    for role in ['block', 'sigkill', 'silent0', 'silent7', 'garbage']:
        target = 'spec182-worker-tool-' + role
        bld.program(target='../' + target,
                    name=target,
                    source=[bld.path.find_node('standalone/spec182-worker-tools/' + role + '.cpp')],
                    cxxflags=['-fPIC', '-O0', '-g0'],
                    install_path=None)

    # Keep integration binaries linked against the complete current DI source
    # closure.  A hand-maintained subset silently went stale as conversation,
    # request-preparation, catalog, and grant sources were added, producing
    # link-only failures even though the installable DI library built cleanly.
    # The compatibility OnnxRuntimeModelRunner.cpp source remains harmless and
    # is retained by the same glob as the production library.
    di_integration_sources = bld.path.parent.ant_glob(
        'NDNSF-DistributedInference/cpp/ndnsf-di/*.cpp') + \
        bld.path.parent.ant_glob(
            'NDNSF-DistributedInference/cpp/adapters/onnx/*.cpp') + \
        bld.path.parent.ant_glob(
            'NDNSF-DistributedInference/cpp/adapters/yolo/*.cpp') + \
        bld.path.parent.ant_glob(
            'NDNSF-DistributedInference/cpp/adapters/qwen/*.cpp')

    # Spec189 T004 production-handle request gate.  It reuses the maintained
    # in-process Runtime fixture; the wire-only selector above remains the
    # direct envelope oracle.  Keep this after the complete DI source closure
    # is defined so Waf configuration is deterministic.
    bld.program(target='../spec189-prepared-request',
                name='spec189-prepared-request',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('integration-tests/di-prepared-request.t.cpp'),
                        bld.path.find_node('integration-tests/ndnsf-integration-fixture.cpp')] +
                       di_integration_sources,
                includes=framework_includes,
                use='ndn-service-framework ndnsf-distributed-repo ' + framework_use + ' ONNXRUNTIME',
                defines=['HAVE_TESTS', 'NDNSF_DI_PROVIDER_TEST_SEAM',
                         'SPEC189_REQUEST_SELECTOR'],
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec189 T005 placement/no-fetch oracle.  The selector uses the
    # production placement strategy and ProviderArtifactCache; it proves that
    # two distinct provider assignments exist and that no fetch/assembly
    # builder runs before an authenticated Selection projection is present.
    bld.program(target='../spec189-placement-oracle',
                name='spec189-placement-oracle',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('integration-tests/spec189-placement-oracle.t.cpp')] +
                       di_integration_sources,
                includes=framework_includes,
                use='ndn-service-framework ' + framework_use + ' ONNXRUNTIME',
                defines=['HAVE_TESTS', 'SPEC189_PLACEMENT_SELECTOR'],
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec185 B0C DI delegation selector.  Link the production
    # NativeInferenceClient and the complete DI source closure.  The target
    # includes the Core-only fail-closed checks plus real Provider-backed ACK,
    # durable-cancel, and conversation-commit-failure fixtures.
    bld.program(target='../spec185-di-core-operation',
                name='spec185-di-core-operation',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('integration-tests/di-core-operation.t.cpp'),
                        bld.path.find_node('integration-tests/ndnsf-di-core-flow.t.cpp'),
                        bld.path.find_node('integration-tests/ndnsf-integration-fixture.cpp')] +
                       di_integration_sources,
                includes=framework_includes,
                use='ndn-service-framework ' + framework_use + ' ONNXRUNTIME',
                defines=['HAVE_TESTS'],
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec185 B3 prepared-request projection selector.  Keep the public
    # PreparedModel request path in its own C++ binary so package reuse,
    # request identity allocation, input/reference validation, and native
    # cancellation are observed independently of the larger Core flow.
    bld.program(target='../spec185-prepared-request',
                name='spec185-prepared-request',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('integration-tests/di-prepared-request.t.cpp'),
                        bld.path.find_node('integration-tests/ndnsf-integration-fixture.cpp')] +
                       di_integration_sources,
                includes=framework_includes,
                use='ndn-service-framework ' + framework_use + ' ONNXRUNTIME',
                defines=['HAVE_TESTS', 'NDNSF_DI_PROVIDER_TEST_SEAM'],
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec187's YOLO MiniNDN selector reuses the production-backed served
    # Provider fixture, but gives it an independent binary and suite identity.
    # The Python MiniNDN harness may launch this selector as a child; all
    # ACK/Selection/Provider/Response assertions remain in this C++ source.
    bld.program(target='../spec187-yolo-minindn',
                name='spec187-yolo-minindn',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('integration-tests/di-prepared-request.t.cpp'),
                        bld.path.find_node('integration-tests/ndnsf-integration-fixture.cpp')] +
                       di_integration_sources,
                includes=framework_includes,
                use='ndnsf-distributed-inference ndn-service-framework ' + framework_use + ' ONNXRUNTIME',
                defines=['HAVE_TESTS', 'NDNSF_DI_PROVIDER_TEST_SEAM',
                         'SPEC187_YOLO_SELECTOR'],
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec188 repeats the same candidate-bound YOLO request through the
    # maintained MiniNDN runner.  Keep a distinct selector/suite identity so
    # its two-run evidence cannot be confused with the Spec187 qualification;
    # the production DI source closure and C++ assertions remain shared.
    bld.program(target='../spec188-yolo-repeat',
                name='spec188-yolo-repeat',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('integration-tests/di-prepared-request.t.cpp'),
                        bld.path.find_node('integration-tests/ndnsf-integration-fixture.cpp')] +
                       di_integration_sources,
                includes=framework_includes,
                use='ndnsf-distributed-inference ndnsf-distributed-repo ndn-service-framework ' + framework_use + ' ONNXRUNTIME',
                defines=['HAVE_TESTS', 'NDNSF_DI_PROVIDER_TEST_SEAM',
                         'SPEC188_YOLO_SELECTOR'],
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec185 B4 prepared-conversation selector.  Keep the provider-backed
    # two-turn wrapper path beside the B3 request fixture and add the focused
    # opaque-checkpoint API boundary cases from their dedicated translation
    # unit.  The complete DI source closure is shared with the installable
    # native library through di_integration_sources.
    bld.program(target='../spec185-prepared-conversation',
                name='spec185-prepared-conversation',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('integration-tests/di-prepared-request.t.cpp'),
                        bld.path.find_node('integration-tests/di-prepared-conversation.t.cpp'),
                        bld.path.find_node('integration-tests/ndnsf-integration-fixture.cpp')] +
                       di_integration_sources,
                includes=framework_includes,
                use='ndn-service-framework ' + framework_use + ' ONNXRUNTIME',
                defines=['HAVE_TESTS', 'NDNSF_DI_PROVIDER_TEST_SEAM'],
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                rpath=[bld.bldnode.abspath()], install_path=None)

    # Spec185 B5 provider assembly selector.  The fixture exercises the
    # public C++ ProviderConfig/Provider façade, Provider-only Runtime role
    # separation, authenticated identity binding, scoped registration and
    # idempotent drain/close against the complete DI source closure.
    bld.program(target='../spec185-provider-assembly',
                name='spec185-provider-assembly',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('integration-tests/di-prepared-provider.t.cpp'),
                        bld.path.find_node('integration-tests/ndnsf-integration-fixture.cpp')] +
