# -*- Mode: python; py-indent-offset: 4; indent-tabs-mode: nil; coding: utf-8; -*-

top = '..'

def build(bld):
    framework_sources = bld.path.parent.ant_glob([
        'ndn-service-framework/NDNSFMessages.cpp',
        'ndn-service-framework/InvocationStream.cpp',
        'ndn-service-framework/CertificatePublisher.cpp',
        'ndn-service-framework/ConfigManager.cpp',
        'ndn-service-framework/PolicyParser.cpp',
        'ndn-service-framework/CertificateBootstrap.cpp',
        'ndn-service-framework/ServiceProvider.cpp',
        'ndn-service-framework/ServiceUser.cpp',
        'ndn-service-framework/ServiceController.cpp',
        'ndn-service-framework/Stream.cpp',
        'ndn-service-framework/StreamFacade.cpp',
        'ndn-service-framework/HybridMessageCrypto.cpp',
        'ndn-service-framework/RequestConfidentiality.cpp',
        'ndn-service-framework/ExecutionLease.cpp',
        'ndn-service-framework/NetworkTelemetry.cpp',
        'ndn-service-framework/TimelineTrace.cpp',
        'ndn-service-framework/GenericSelectionTxnStore.cpp',
        'ndn-service-framework/ControllerVersion.cpp',
        'ndn-service-framework/PolicyStatus.cpp',
        'ndn-service-framework/ControllerGenerationStore.cpp',
        'ndn-service-framework/RevocationState.cpp',
        'ndn-service-framework/PolicyRefreshCoordinator.cpp',
        'ndn-service-framework/common.cpp',
        'ndn-service-framework/utils.cpp',
    ])
    framework_includes = ['..', '../ndn-service-framework',
                          '../NDNSF-DistributedRepo/include']
    framework_use = 'NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL DL'
    di_integration_sources = bld.path.parent.ant_glob([
        'NDNSF-DistributedInference/cpp/ndnsf-di/AsyncDataflowRuntime.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/DependencyWaitScheduler.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/ExecutionEvidence.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/NativeExecutionPlan.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/NativeExecutionPlanJson.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/DistributedExecutionConsistency.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/NativeModelRunner.cpp',
        # The integration target exercises the real CPU ONNX adapter when
        # NDNSF_DI_TEST_ONNX_MODEL is set; keep the adapter object in the same
        # target rather than accidentally testing only the fake runner.
        'NDNSF-DistributedInference/cpp/adapters/onnx/OnnxRuntimeModelRunner.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/NativeProviderHandler.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/NativeEpochCoordinator.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/NativeProviderSession.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/NativeProviderRuntime.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/NdnsfCollaborationDependencyIo.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/ProviderRoleWorker.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/CollectiveRuntime.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/TensorBundleCodec.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/NdnsfCollectiveControl.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/ProviderGroupCoordinator.cpp',
        'NDNSF-DistributedInference/cpp/ndnsf-di/ProtectedRuntime.cpp',
    ])

    bld.program(target='../unit-tests',
                name='unit-tests',
                source=([bld.path.find_node('main.cpp')] +
                        bld.path.ant_glob('unit-tests/**/*.cpp',
                                           excl=['unit-tests/sanitizer/**']) +
                        bld.path.parent.ant_glob([
                            'ndn-service-framework/NDNSFMessages.cpp',
                            'ndn-service-framework/InvocationStream.cpp',
                            'ndn-service-framework/CertificatePublisher.cpp',
                            'ndn-service-framework/ConfigManager.cpp',
                            'ndn-service-framework/PolicyParser.cpp',
                            'ndn-service-framework/CertificateBootstrap.cpp',
                            'ndn-service-framework/ServiceProvider.cpp',
                            'ndn-service-framework/ServiceUser.cpp',
                            'ndn-service-framework/Stream.cpp',
                            'ndn-service-framework/StreamFacade.cpp',
                            'ndn-service-framework/HybridMessageCrypto.cpp',
                            'ndn-service-framework/RequestConfidentiality.cpp',
                            'ndn-service-framework/ExecutionLease.cpp',
                            'ndn-service-framework/NetworkTelemetry.cpp',
                            'ndn-service-framework/TimelineTrace.cpp',
                            'ndn-service-framework/GenericSelectionTxnStore.cpp',
                            'ndn-service-framework/ControllerVersion.cpp',
                            'ndn-service-framework/PolicyStatus.cpp',
                            'ndn-service-framework/ControllerGenerationStore.cpp',
                            'ndn-service-framework/RevocationState.cpp',
                            'ndn-service-framework/PolicyRefreshCoordinator.cpp',
                            'ndn-service-framework/common.cpp',
                            'ndn-service-framework/utils.cpp',
                            'NDNSF-UAV-APP/shared/UavProtocol.cpp',
                            'NDNSF-UAV-APP/shared/UavMissionSession.cpp',
                            'NDNSF-UAV-APP/shared/UavCollaborationPolicy.cpp',
                            'NDNSF-UAV-APP/shared/UavDetectorProvider.cpp',
                            'NDNSF-UAV-APP/shared/UavMultiViewRecognition.cpp',
                            'NDNSF-UAV-APP/shared/UavDiagnostics.cpp',
                            'NDNSF-UAV-APP/ground-station/UavIncidentCoordinator.cpp',
                            'NDNSF-UAV-APP/drone/UavCollaborationParticipant.cpp',
                            'NDNSF-UAV-APP/shared/UavVideoPipeline.cpp',
                            'NDNSF-UAV-APP/shared/UavSensorStreams.cpp',
                            'NDNSF-DistributedRepo/src/ArtifactManifest.cpp',
                            'NDNSF-DistributedRepo/src/ArtifactTransfer.cpp',
                            'NDNSF-DistributedRepo/src/ArtifactTypes.cpp',
                            'NDNSF-DistributedRepo/src/backends/FilesystemArtifactStore.cpp',
                            'NDNSF-DistributedRepo/src/RepoStoreBackend.cpp',
                            'NDNSF-DistributedRepo/src/RepoProtocol.cpp',
                            'NDNSF-DistributedRepo/src/RepoTypes.cpp',
                        ]) +
                        bld.path.parent.ant_glob([
                            'NDNSF-DistributedInference/cpp/ndnsf-di/*.cpp',
                            'NDNSF-DistributedInference/cpp/adapters/onnx/*.cpp',
                            'NDNSF-DistributedInference/cpp/adapters/qwen/*.cpp',
                        ])),
                includes=['..', '../ndn-service-framework',
                          '../NDNSF-DistributedRepo/include'],
                use='NDN_CXX NDN_SVS PROTOBUF NAC-ABE NDNSD BOOST OPENSSL ONNXRUNTIME GSTREAMER GMODULE FFI PCRE DL',
                # NAC-ABE exposes its test-only authority state under
                # HAVE_TESTS.  The framework's generated config header does
                # not propagate that macro into NAC-ABE's CMake-style public
                # headers, so define it explicitly for the test executable.
                defines=['HAVE_TESTS'],
                # GCC 9 can ICE during inlining while compiling the large UAV
                # protocol and SVS translation units. Tests do not depend on
                # optimization or debug info, so use a low-memory deterministic
                # test build while leaving production flags unchanged.
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                # GNU ld can incorrectly relax a GOTPCREL push of an
                # address-taken inline constexpr into a direct call.  The
                # monolithic test binary exercises many such constants.
                linkflags=['-Wl,--no-relax'],
                install_path=None)

    # Keep the packet-level DummyClientFace/SVSPubSub flow runnable as a
    # separate integration target.  It intentionally reuses the existing
    # production-backed smoke fixture, but does not pull in the full unit-test
    # corpus or silently classify it as a unit-only result.
    bld.program(target='../integration-tests',
                name='integration-tests',
                source=[bld.path.parent.find_node('tests/main.cpp'),
                        bld.path.find_node('unit-tests/ndn-svs-smoke.t.cpp'),
                        bld.path.find_node('integration-tests/ndnsf-data-v1-svs-flow.t.cpp'),
                        bld.path.find_node('integration-tests/ndnsf-di-core-flow.t.cpp'),
                        bld.path.find_node('integration-tests/invocation-stream-flow.t.cpp'),
                        bld.path.find_node('integration-tests/uav-collaboration-flow.t.cpp'),
                        bld.path.find_node('integration-tests/uav-multiview-flow.t.cpp'),
                        bld.path.find_node('integration-tests/controller-revocation-flow.t.cpp'),
                        bld.path.find_node('integration-tests/controller-version-refresh.t.cpp'),
                        bld.path.find_node('integration-tests/request-scoped-selection.t.cpp'),
                        bld.path.find_node('integration-tests/request-scoped-response-confidentiality.t.cpp'),
                        bld.path.parent.find_node('NDNSF-UAV-APP/shared/UavProtocol.cpp'),
                        bld.path.parent.find_node('NDNSF-UAV-APP/shared/UavMissionSession.cpp'),
                        bld.path.parent.find_node('NDNSF-UAV-APP/shared/UavDetectorProvider.cpp'),
                        bld.path.parent.find_node('NDNSF-UAV-APP/shared/UavMultiViewRecognition.cpp'),
                        bld.path.parent.find_node('NDNSF-UAV-APP/shared/UavDiagnostics.cpp'),
                        bld.path.parent.find_node('NDNSF-UAV-APP/ground-station/UavIncidentCoordinator.cpp'),
                        bld.path.parent.find_node('NDNSF-UAV-APP/drone/UavCollaborationParticipant.cpp'),
                        bld.path.find_node('integration-tests/ndnsf-integration-fixture.cpp')] +
                       framework_sources + di_integration_sources,
                includes=framework_includes,
                use=framework_use + ' ONNXRUNTIME',
                # Keep NAC-ABE's test visibility contract enabled for the
                # integration target as well as the unit-test target.
                defines=['HAVE_TESTS'],
                # Keep the same GCC-9 ICE guard for the integration target.
                cxxflags=['-fPIC', '-O0', '-g0', '-fno-inline'],
                linkflags=['-Wl,--no-relax'],
                install_path=None)
