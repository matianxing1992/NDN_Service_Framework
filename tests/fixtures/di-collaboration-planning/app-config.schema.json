{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndnsf.example/spec/163/app-config.schema.json",
  "title": "NDNSF-DI application configuration V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity",
    "state",
    "repository",
    "planning",
    "cache"
  ],
  "properties": {
    "schema": {
      "const": "ndnsf-di-application/v2"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requester", "controller", "trust_schema"],
      "properties": {
        "requester": {
          "type": "string",
          "pattern": "^/"
        },
        "controller": {
          "type": "string",
          "pattern": "^/"
        },
        "trust_schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix"],
      "properties": {
        "prefix": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "adapters", "default_adapter"],
      "properties": {
        "strategy": {
          "$ref": "#/$defs/digestPinnedStrategy"
        },
        "adapters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow"],
          "properties": {
            "allow": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/digestPinnedComponent"
              }
            }
          }
        },
        "default_adapter": {
          "type": "string",
          "minLength": 1
        },
        "gpu_safety_margin": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable_model_shards", "derived_state"],
      "properties": {
        "immutable_model_shards": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "retain_verified",
            "selected_and_inflight_evictable"
          ],
          "properties": {
            "retain_verified": {
              "type": "boolean"
            },
            "selected_and_inflight_evictable": {
              "const": false
            }
          }
        },
        "derived_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "exact_prefix_local_reuse",
            "cross_tenant_reuse",
            "migration"
          ],
          "properties": {
            "default": {
              "enum": ["destroy", "retain-local"]
            },
            "exact_prefix_local_reuse": {
              "type": "boolean"
            },
            "cross_tenant_reuse": {
              "const": false
            },
            "migration": {
              "enum": ["disabled", "explicit-only"]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digestPinnedStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "digestPinnedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
