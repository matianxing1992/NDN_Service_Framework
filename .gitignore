# Local experiment results (MiniNDN run keys are generated per campaign —
# never commit; redacted evidence lives under specs/<n>/evidence/)
/results/

# Local Chinese README translations
README_ch.md

# Local UAV roadmap drafts (do not commit)
NDNSF-UAV-APP/ROADMAP.md
NDNSF-UAV-APP/ROADMAP_ch.md

# Local analysis state
.planning/
.codegraph/

