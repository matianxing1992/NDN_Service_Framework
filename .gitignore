packaging/ndnsf-di-container/generated/
tests/container/.tmp/
tests/container/**/actual/
**/identity-private/
**/container-secrets/

# Local Spec Kit documents, agent instructions, and Codex working state. These
# remain available in the workspace for local planning/evidence, but are not
# repository contents. Keep these rules in the shared ignore file rather than
# relying only on .git/info/exclude, so a clone cannot accidentally stage them.
/specs/
/**/specs/
/.specify/
/**/.specify/
/.codex/
/**/.codex/
/.agents/
/**/.agents/
/.claude/
/**/.claude/
/.deepseek/
/**/.deepseek/
/AGENTS.md
/**/AGENTS.md
/CLAUDE.md
/**/CLAUDE.md
/CODEX*.md
/**/CODEX*.md
/**/codex*.md
/scripts/codex_state_recovery.sh
