# Local waf build output trees (clang/gcc/spec179 variants)
/build-clang*/
/build-gcc*/
/build-spec179*/

# Codex/experiment scratch outputs are evidence inputs, not source.  Keep them
# out of Git and CodeGraph; durable summaries belong under specs/*/evidence/.
.codex-tmp/
