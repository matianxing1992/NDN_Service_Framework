#!/bin/bash
#SBATCH --job-name=@@JOB_NAME@@
#SBATCH --partition=@@PARTITION@@
#SBATCH --account=@@ACCOUNT@@
#SBATCH --qos=@@QOS@@
#SBATCH --time=@@WALL_TIME@@
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=@@CPUS@@
#SBATCH --mem=@@MEMORY@@
#SBATCH --gres=gpu:@@GPU_TYPE@@:@@GPU_COUNT@@
#SBATCH --output=@@LOG_ROOT@@/slurm-%j.out
#SBATCH --error=@@LOG_ROOT@@/slurm-%j.err
set -euo pipefail
scratch="/tmp/$USER/ndnsf-di/$SLURM_JOB_ID"
staging="$scratch/evidence"
mkdir -p "$staging" "@@LOG_ROOT@@"
finish() {
  rc=$?
  trap - EXIT INT TERM
  state=COMPLETED; [[ $rc -eq 0 ]] || state=FAILED
  @@FINALIZER@@ --staging "$staging" --destination "@@EVIDENCE_ROOT@@" \
    --run-id "@@RUN_ID@@" --state "$state" --exit-code "$rc"
  rm -rf "$scratch"
  exit "$rc"
}
trap finish EXIT INT TERM
@@COMPUTE_PREFLIGHT@@ --scratch "$scratch" --gpu-type "@@GPU_TYPE@@" --gpu-count "@@GPU_COUNT@@"
@@RUN_CONTAINER@@ \
  --sif "@@SIF_PATH@@" \
  --sif-sha256 "@@SIF_SHA256@@" \
  --project "@@PROJECT_ROOT@@" \
  --scratch "$scratch" \
  --release-bind "@@PROJECT_ROOT@@/releases" \
  --models "@@MODEL_PATH@@" \
  --artifacts "@@ARTIFACT_ROOT@@" \
  --identity "@@IDENTITY_ROOT@@" \
  --evidence "@@EVIDENCE_ROOT@@" \
  -- \
  /opt/ndnsf/bin/run-ndnsf-qwen.sh --scratch /scratch --evidence /scratch/evidence \
    --nfd-config /artifacts/nfd.conf --controller-args /artifacts/controller.args \
    --provider-args-dir /artifacts/providers --user-args /artifacts/user.args
