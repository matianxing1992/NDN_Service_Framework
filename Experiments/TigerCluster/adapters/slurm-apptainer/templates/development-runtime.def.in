    rm -rf /opt/venv/lib/python3.10/site-packages/ndnsf-*.dist-info /opt/venv/lib/python3.10/site-packages/py_repoclient-*.dist-info /opt/venv/lib/python3.10/site-packages/ndnsf_di*.dist-info /opt/venv/lib/python3.10/site-packages/ndnsf_distributed_inference-*.dist-info
    rm -rf /opt/ndnsf-di/replay /opt/ndnsf-di/current/include/nac-abe /opt/ndnsf-di/current/include/ndn-svs /opt/ndnsf-di/current/include/ndn-service-framework

    install -d /opt/ndnsf-di/current/bin /opt/ndnsf-di/current/lib/pkgconfig /opt/ndnsf-di/current/manifest /opt/ndnsf-di/replay /opt/venv/lib/python3.10/site-packages
    install -m 0755 /opt/ndnsf-candidate/bin/di-native-provider /opt/ndnsf-di/current/bin/di-native-provider
    install -m 0755 /opt/ndnsf-candidate/bin/di-native-fault-provider /opt/ndnsf-di/current/bin/di-native-fault-provider
    install -m 0755 /opt/ndnsf-candidate/bin/App_ServiceController /opt/ndnsf-di/current/bin/App_ServiceController
    install -m 0755 /opt/ndnsf-candidate/lib/libndn-service-framework.so.0.1.0 /opt/ndnsf-di/current/lib/libndn-service-framework.so.0.1.0
    ln -s libndn-service-framework.so.0.1.0 /opt/ndnsf-di/current/lib/libndn-service-framework.so
    install -m 0755 /opt/ndnsf-candidate/lib/libndnsf-distributed-inference.so /opt/ndnsf-di/current/lib/libndnsf-distributed-inference.so
    install -m 0755 /opt/ndnsf-candidate/lib/libndn-svs.so.0.1.0 /opt/ndnsf-di/current/lib/libndn-svs.so.0.1.0
    ln -s libndn-svs.so.0.1.0 /opt/ndnsf-di/current/lib/libndn-svs.so
    install -m 0755 /opt/ndnsf-candidate/lib/libnac-abe.so /opt/ndnsf-di/current/lib/libnac-abe.so
    install -m 0755 /opt/ndnsf-candidate/lib/libopenabe.so /opt/ndnsf-di/current/lib/libopenabe.so
    install -m 0755 /opt/ndnsf-candidate/lib/librelic.so /opt/ndnsf-di/current/lib/librelic.so
    install -m 0755 /opt/ndnsf-candidate/lib/librelic_ec.so /opt/ndnsf-di/current/lib/librelic_ec.so
    install -m 0755 /opt/ndnsf-candidate/lib/libndnsd.so.0.1.0 /opt/ndnsf-di/current/lib/libndnsd.so.0.1.0
    ln -s libndnsd.so.0.1.0 /opt/ndnsf-di/current/lib/libndnsd.so
    install -m 0644 /opt/ndnsf-candidate/lib/pkgconfig/libndn-service-framework.pc /opt/ndnsf-di/current/lib/pkgconfig/libndn-service-framework.pc
    install -m 0644 /opt/ndnsf-candidate/lib/pkgconfig/ndnsf-distributed-inference.pc /opt/ndnsf-di/current/lib/pkgconfig/ndnsf-distributed-inference.pc
    install -d /opt/ndnsf-di/current/include
    rm -rf /opt/ndnsf-di/current/include/NDNSF-DistributedInference
    cp -a /opt/ndnsf-candidate/include/. /opt/ndnsf-di/current/include/
    install -m 0644 /opt/ndnsf-candidate/lib/pkgconfig/libnac-abe.pc /opt/ndnsf-di/current/lib/pkgconfig/libnac-abe.pc
    install -m 0644 /opt/ndnsf-candidate/lib/pkgconfig/libndn-svs.pc /opt/ndnsf-di/current/lib/pkgconfig/libndn-svs.pc
    install -m 0644 /opt/ndnsf-candidate/lib/pkgconfig/ndnsd.pc /opt/ndnsf-di/current/lib/pkgconfig/ndnsd.pc
    install -m 0644 /opt/ndnsf-candidate/manifest/verify-native.py /opt/ndnsf-di/current/manifest/verify-native.py
    cp -a /opt/ndnsf-candidate/python/. /opt/venv/lib/python3.10/site-packages/
    cp -a /opt/ndnsf-candidate/replay/. /opt/ndnsf-di/replay/
    install -m 0644 /opt/ndnsf-candidate/manifest/container-native-build.json /opt/ndnsf-di/current/manifest/container-native-build.json
    install -m 0644 /opt/ndnsf-candidate/manifest/container-configure-closure.json /opt/ndnsf-di/current/manifest/container-configure-closure.json
    install -m 0755 /opt/ndnsf-candidate/replay/repo/packaging-jobs-spec180/run-ndnsf-yolo.sh /opt/ndnsf/bin/run-ndnsf-yolo.sh
    # Publish a symlink-free application tree for the external APP packager.
    # The /opt/ndnsf-di/current tree above remains only as a compatibility
    # runtime for the legacy complete-SIF checks; the pair runner never falls
    # back to it. Core/DI are repository outputs; external libraries below are
    # byte-identical base copies for compatibility, not a third build layer.
    # Copying the whole candidate lib directory would still shadow unrelated
    # base objects, so the allowlist below is explicit.
    test ! -e /opt/ndnsf-app
    test ! -L /opt/ndnsf-app
    install -d /opt/ndnsf-app/bin /opt/ndnsf-app/lib /opt/ndnsf-app/python \
      /opt/ndnsf-app/manifest /opt/ndnsf-app/replay
    install -m 0755 /opt/ndnsf-candidate/bin/di-native-provider /opt/ndnsf-app/bin/di-native-provider
    install -m 0755 /opt/ndnsf-candidate/bin/di-native-fault-provider /opt/ndnsf-app/bin/di-native-fault-provider
    install -m 0755 /opt/ndnsf-candidate/bin/App_ServiceController /opt/ndnsf-app/bin/App_ServiceController
    install -m 0755 /opt/ndnsf-candidate/lib/libndnsf-distributed-inference.so \
      /opt/ndnsf-app/lib/libndnsf-distributed-inference.so
    install -m 0755 /opt/ndnsf-candidate/lib/libndn-service-framework.so.0.1.0 \
      /opt/ndnsf-app/lib/libndn-service-framework.so.0.1.0
    install -m 0755 /opt/ndnsf-candidate/lib/libndn-svs.so.0.1.0 \
      /opt/ndnsf-app/lib/libndn-svs.so.0.1.0
    install -m 0755 /opt/ndnsf-candidate/lib/libnac-abe.so \
      /opt/ndnsf-app/lib/libnac-abe.so
    install -m 0755 /opt/ndnsf-candidate/lib/libndnsd.so.0.1.0 \
      /opt/ndnsf-app/lib/libndnsd.so.0.1.0
    install -m 0755 /opt/ndnsf-candidate/lib/libopenabe.so \
      /opt/ndnsf-app/lib/libopenabe.so
    install -m 0755 /opt/ndnsf-candidate/lib/librelic.so \
      /opt/ndnsf-app/lib/librelic.so
    install -m 0755 /opt/ndnsf-candidate/lib/librelic_ec.so \
      /opt/ndnsf-app/lib/librelic_ec.so
    cp -aL /opt/ndnsf-candidate/python/. /opt/ndnsf-app/python/
    cp -aL /opt/ndnsf-candidate/replay/. /opt/ndnsf-app/replay/
    cp -aL /opt/ndnsf-candidate/replay/source-seal.json /opt/ndnsf-app/manifest/source-seal.json
    /opt/venv/bin/python - <<'PY'
import hashlib
import json
import os
import stat
from pathlib import Path

root = Path('/opt/ndnsf-app')
seal = root / 'manifest/source-seal.json'
h = hashlib.sha256(seal.read_bytes()).hexdigest()
(root / 'manifest/app-runtime.lock.json').write_text(json.dumps({
    'schemaVersion': 'ndnsf-app-runtime-lock-v1',
    'status': 'PASS',
    'buildBoundary': 'container-runtime-in-sif',
    'sourceSealSha256': 'sha256:' + h,
    'runtimeContract': {
        'appNativeLibraries': [
            'libndn-service-framework.so.0.1.0',
            'libndnsf-distributed-inference.so', 'libndn-svs.so.0.1.0',
            'libnac-abe.so', 'libndnsd.so.0.1.0', 'libopenabe.so',
            'librelic.so', 'librelic_ec.so',
        ],
        'python': '/opt/venv/bin/python',
        'ndnBaseLib': '/opt/ndn-base/lib',
        'onnxRuntimeLib': '/opt/onnxruntime/lib',
    },
}, indent=2, sort_keys=True) + '\n', encoding='utf-8')
for directory, subdirectories, filenames in os.walk(root, followlinks=False):
    for name in sorted(subdirectories + filenames):
        path = Path(directory) / name
        mode = path.lstat().st_mode
        if stat.S_ISLNK(mode) or not (stat.S_ISDIR(mode) or stat.S_ISREG(mode)):
            raise SystemExit('APP_LAYOUT_SPECIAL_FILE:' + str(path))
libraries = {
    path.relative_to(root / 'lib').as_posix()
    for path in (root / 'lib').rglob('*')
    if path.is_file()
}
expected = {
    'libndn-service-framework.so.0.1.0',
    'libndnsf-distributed-inference.so', 'libndn-svs.so.0.1.0',
    'libnac-abe.so', 'libndnsd.so.0.1.0', 'libopenabe.so',
    'librelic.so', 'librelic_ec.so',
}
if libraries != expected:
    raise SystemExit('APP_NATIVE_LIBRARY_CLOSURE_MISMATCH')
PY
    # APP_LAYOUT_VERIFY=ndnsf-app-v2: the external bundle has no base-owned
    # libraries or symlink/special-file escape paths.
    for path in /opt/venv/lib/python3.10/site-packages/torch* \
                /opt/venv/lib/python3.10/site-packages/transformers* \
                /opt/venv/lib/python3.10/site-packages/functorch*; do
        if [ -e "$path" ]; then rm -rf "$path"; fi
    done
    rm -f /opt/venv/bin/torchrun /opt/venv/bin/transformers
    ldconfig

    # The inherited SDK may install 91-sdk-environment.sh. The repository
    # runtime owns the later layer, including its library search directories.
    cat > /.singularity.d/env/92-ndnsf-environment.sh <<'NDNSF_ENV'
export PATH=/opt/venv/bin:/opt/ndnsf-di/current/bin:/opt/ndn-base/bin:/usr/bin:/bin:/usr/sbin:/sbin
export LD_LIBRARY_PATH=/opt/ndnsf-di/current/lib:/opt/ndn-base/lib:/opt/onnxruntime/lib
export PKG_CONFIG_PATH=/opt/ndnsf-di/current/lib/pkgconfig:/opt/ndn-base/lib/pkgconfig:/opt/onnxruntime/lib/pkgconfig
export PYTHONNOUSERSITE=1
NDNSF_ENV

    extension_count=$(find /opt/venv/lib/python3.10/site-packages/ndnsf -maxdepth 1 -name '_ndnsf*.so' -type f | wc -l)
    test "$extension_count" -eq 1
    extension_path=$(find /opt/venv/lib/python3.10/site-packages/ndnsf -maxdepth 1 -name '_ndnsf*.so' -type f)
    repo_extension_count=$(find /opt/venv/lib/python3.10/site-packages/py_repoclient -maxdepth 1 -name '_py_repoclient*.so' -type f | wc -l)
    test "$repo_extension_count" -eq 1
    repo_extension_path=$(find /opt/venv/lib/python3.10/site-packages/py_repoclient -maxdepth 1 -name '_py_repoclient*.so' -type f)
    sha256sum /opt/ndnsf-di/current/lib/libndnsd.so.0.1.0 /opt/ndnsf-di/current/lib/libnac-abe.so /opt/ndnsf-di/current/lib/libopenabe.so /opt/ndnsf-di/current/lib/librelic.so /opt/ndnsf-di/current/lib/librelic_ec.so "$repo_extension_path" /opt/ndnsf-di/current/bin/di-native-provider /opt/ndnsf-di/current/bin/di-native-fault-provider /opt/ndnsf-di/current/bin/App_ServiceController /opt/ndnsf-di/current/lib/libndn-service-framework.so.0.1.0 /opt/ndnsf-di/current/lib/libndnsf-distributed-inference.so /opt/ndnsf-di/current/lib/libndn-svs.so.0.1.0 "$extension_path" > /opt/ndnsf-di/current/manifest/final-native-sha256.txt

    /opt/venv/bin/python /opt/ndnsf-di/current/manifest/verify-native.py final

    PYTHONNOUSERSITE=1 /opt/venv/bin/python -c 'import ndnsf._ndnsf, ndnsf_distributed_inference, py_repoclient, ndn, tokenizers, onnx, numpy, onnxruntime; import ndnsf_distributed_inference.native_assembly_helper, ndnsf_distributed_inference.native_token_decode_helper'
    test -x /opt/ndnsf-di/replay/repo/Experiments/NDNSF_DI_YoloAckDriven_Minindn.py
    test -f /opt/ndnsf-di/replay/source-seal.json
    for command in nfd nfdc ndnsec; do
      command -v "$command"
    done
    if ldd /opt/ndnsf-di/current/bin/di-native-provider | grep -q 'not found'; then
      exit 1
    fi
    if ldd /opt/ndnsf-di/current/bin/di-native-fault-provider | grep -q 'not found'; then
      exit 1
    fi
    if ldd "$extension_path" | grep -q 'not found'; then
      exit 1
    fi
    rm -rf /opt/ndnsf-candidate /opt/ndnsf-stage /src/ndnsf /src/ndn-svs /src/nac-abe /src/ndn-sd /build-input

%environment
    export PATH=/opt/venv/bin:/opt/ndnsf-di/current/bin:$PATH
    export LD_LIBRARY_PATH=/opt/ndnsf-di/current/lib:/opt/onnxruntime/lib
    export PKG_CONFIG_PATH=/opt/ndnsf-di/current/lib/pkgconfig:/opt/onnxruntime/lib/pkgconfig
    export PYTHONNOUSERSITE=1

%labels
    org.ndnsf.di.build-boundary container-runtime-in-sif
    org.ndnsf.di.native-build-manifest /opt/ndnsf-di/current/manifest/container-native-build.json
    org.ndnsf.di.release @RELEASE@
    org.ndnsf.di.source-seal @SEAL_DIGEST@
