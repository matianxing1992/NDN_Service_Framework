    unset PYTHONOPTIMIZE PYTHONHOME PYTHONPATH
    /opt/venv/bin/python /opt/ndn-base/manifest/dependency-sdk.py verify
    /opt/venv/bin/python - <<'PY'
import json
from pathlib import Path
import subprocess
body = json.loads(Path('/opt/ndnsf-candidate/manifest/container-native-build.json').read_text())
for name, version in body['runtimeAptPackages'].items():
    actual = subprocess.check_output(['dpkg-query', '-W', '-f=${Version}', name], text=True)
    assert actual == version, 'BASE_RUNTIME_PACKAGE_CHANGED:' + name
PY
    export PATH=/usr/bin:/bin:/usr/sbin:/sbin:/opt/venv/bin:/opt/ndnsf-di/current/bin
