+void
+SVSyncCore::observeSyncProductionThread(bool expectWorker)
+{
+  if (!m_syncProductionDiagnosticsEnabled.load(std::memory_order_relaxed)) {
+    return;
+  }
+
+  const auto token = threadToken();
+  const auto faceToken = m_syncProductionFaceThreadToken.load(std::memory_order_relaxed);
+  if (!expectWorker) {
+    if (token != faceToken) {
+      incrementStat(m_syncProductionThreadOwnerViolations);
+    }
+    return;
+  }
+
+  auto workerToken = m_syncProductionWorkerThreadToken.load(std::memory_order_relaxed);
+  if (workerToken == 0) {
+    m_syncProductionWorkerThreadToken.compare_exchange_strong(
+      workerToken, token, std::memory_order_relaxed);
+    workerToken = m_syncProductionWorkerThreadToken.load(std::memory_order_relaxed);
+  }
+  if (token == faceToken || token != workerToken) {
+    incrementStat(m_syncProductionThreadOwnerViolations);
+  }
+  if (token != workerToken) {
+    incrementStat(m_syncProductionWorkerThreadChanges);
+  }
+}
+
+void
+SVSyncCore::signSyncInterestMeasured(Interest& interest, bool expectWorker)
+{
+  if (!m_syncProductionDiagnosticsEnabled.load(std::memory_order_relaxed)) {
+    signSyncInterest(interest);
+    return;
+  }
+
+  observeSyncProductionThread(expectWorker);
+  const auto active =
+    m_syncProductionActiveSigners.fetch_add(1, std::memory_order_relaxed) + 1;
+  updateMaximum(m_syncProductionMaxActiveSigners, active);
+  const auto start = SteadyClock::now();
+  try {
+    signSyncInterest(interest);
+  }
+  catch (...) {
+    m_syncProductionActiveSigners.fetch_sub(1, std::memory_order_relaxed);
+    throw;
+  }
+  incrementStat(m_syncProductionSignNs, elapsedNs(start, SteadyClock::now()));
+  m_syncProductionActiveSigners.fetch_sub(1, std::memory_order_relaxed);
+}
