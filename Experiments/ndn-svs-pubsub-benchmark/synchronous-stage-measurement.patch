+enum class StageId : uint16_t {
+#define NDN_SVS_PROFILE_ENUM(symbol, wire, kind, thread, parent) symbol,
+  NDN_SVS_PROFILE_STAGE_LIST(NDN_SVS_PROFILE_ENUM)
+#undef NDN_SVS_PROFILE_ENUM
+  COUNT,
+};
+
+struct StageDefinition
+{
+  StageId stage;
+  const char* id;
+  SpanKind kind;
+  ThreadRole thread;
+  const char* parent;
+};
+
+const StageDefinition&
+getStageDefinition(StageId stage) noexcept;
+
+size_t
+getStageCount() noexcept;
+
+class Profiler
+{
+public:
+  static Profiler&
+  get() noexcept;
+
+  bool
+  isEnabled() const noexcept;
+
+  bool
+  shouldSample(std::string_view traceKey) const noexcept;
+
+  uint64_t
+  nextTraceId() noexcept;
+
+  uint64_t
+  currentTraceId() const noexcept;
+
+  uint64_t
+  nowRawNs() const noexcept;
+
+  void
+  record(StageId stage, std::string_view traceKey, uint64_t startRawNs,
+         uint64_t durationNs, Outcome outcome, uint64_t bytes, uint64_t items,
+         CorrelationMode correlationMode, bool sampled) noexcept;
+
+  void
+  recordInterval(StageId stage, uint64_t traceId, uint64_t startRawNs,
+                 uint64_t durationNs, Outcome outcome = Outcome::Success,
+                 CorrelationMode correlationMode = CorrelationMode::Exact) noexcept;
+
+  void
+  flush() noexcept;
+
+private:
+  Profiler() noexcept;
+  struct Impl;
+  Impl* m_impl;
+};
+
+class TraceScope
+{
+public:
+  TraceScope() noexcept;
+
+  explicit TraceScope(uint64_t traceId) noexcept;
+
+  ~TraceScope() noexcept;
+
+  TraceScope(const TraceScope&) = delete;
+  TraceScope& operator=(const TraceScope&) = delete;
+
+  uint64_t
+  id() const noexcept;
+
+private:
+  uint64_t m_previous = 0;
+  uint64_t m_current = 0;
+};
+
+class Span
+{
+public:
+  explicit Span(StageId stage, std::string_view traceKey,
+                CorrelationMode correlationMode = CorrelationMode::Exact) noexcept;
+
+  explicit Span(StageId stage, uint64_t traceId,
+                CorrelationMode correlationMode = CorrelationMode::Exact) noexcept;
+
+  ~Span() noexcept;
+
+  Span(const Span&) = delete;
+  Span& operator=(const Span&) = delete;
+
+  void
+  setOutcome(Outcome outcome) noexcept;
+
+  void
+  setCounts(uint64_t bytes, uint64_t items = 1) noexcept;
+
+  void
+  stop() noexcept;
+
+private:
+  void
+  start(std::string_view traceKey) noexcept;
+
+  StageId m_stage;
+  std::string m_traceKey;
+  CorrelationMode m_correlationMode;
+  Outcome m_outcome = Outcome::Success;
+  uint64_t m_startRawNs = 0;
+  uint64_t m_bytes = 0;
+  uint64_t m_items = 0;
+  bool m_enabled = false;
+  bool m_sampled = false;
+  bool m_stopped = false;
+};
+
+} // namespace ndn::svs::profile
+
+#endif // NDN_SVS_PROFILE_HPP
