+/* -*- Mode: C++; c-file-style: "gnu"; indent-tabs-mode:nil -*- */
+#include "profile.hpp"
+
+#include <ndn-cxx/util/logger.hpp>
+
+#include <boost/log/core.hpp>
+
+#include <array>
+#include <atomic>
+#include <cerrno>
+#include <charconv>
+#include <climits>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <limits>
+#include <iostream>
+#include <mutex>
+#include <string>
+
+namespace ndn::svs::profile {
+
+NDN_LOG_INIT(ndn_svs.Profile);
+
+namespace {
+
+constexpr size_t STAGE_COUNT = static_cast<size_t>(StageId::COUNT);
+
+constexpr std::array<StageDefinition, STAGE_COUNT> STAGES = {{
+#define NDN_SVS_PROFILE_DEF(symbol, wire, kind, thread, parent) \
+  {StageId::symbol, wire, SpanKind::kind, ThreadRole::thread, parent},
+  NDN_SVS_PROFILE_STAGE_LIST(NDN_SVS_PROFILE_DEF)
+#undef NDN_SVS_PROFILE_DEF
+}};
+
+const char*
+toString(SpanKind kind) noexcept
+{
+  switch (kind) {
+    case SpanKind::LeafCpu: return "leaf-cpu";
+    case SpanKind::Aggregate: return "aggregate";
+    case SpanKind::LockWait: return "lock-wait";
+    case SpanKind::QueueWait: return "queue-wait";
+    case SpanKind::ExternalWait: return "external-wait";
+    case SpanKind::Milestone: return "milestone";
+  }
+  return "invalid";
+}
+
+const char*
+toString(ThreadRole role) noexcept
+{
+  switch (role) {
+    case ThreadRole::AppMain: return "app-main";
+    case ThreadRole::FaceIo: return "face-io";
+    case ThreadRole::Callback: return "callback";
+    case ThreadRole::External: return "external";
+    case ThreadRole::Mixed: return "mixed";
+  }
+  return "invalid";
+}
+
+const char*
+toString(CorrelationMode mode) noexcept
+{
+  switch (mode) {
+    case CorrelationMode::Exact: return "exact";
+    case CorrelationMode::Ambiguous: return "ambiguous";
+    case CorrelationMode::Censored: return "censored";
+  }
+  return "invalid";
+}
+
+const char*
+toString(Outcome outcome) noexcept
+{
+  switch (outcome) {
+    case Outcome::Success: return "success";
+    case Outcome::Miss: return "miss";
+    case Outcome::Invalid: return "invalid";
+    case Outcome::Nack: return "nack";
+    case Outcome::Timeout: return "timeout";
+    case Outcome::Exception: return "exception";
+    case Outcome::Skipped: return "skipped";
+  }
+  return "invalid";
+}
+
+bool
+parseEnabled(const char* value) noexcept
+{
+  if (value == nullptr)
+    return false;
+  return std::strcmp(value, "1") == 0 || std::strcmp(value, "true") == 0 ||
+         std::strcmp(value, "yes") == 0;
+}
+
+uint64_t
+parsePositive(const char* value, uint64_t fallback) noexcept
+{
+  if (value == nullptr || *value == '\0')
+    return fallback;
+  errno = 0;
+  char* end = nullptr;
+  const unsigned long long parsed = std::strtoull(value, &end, 10);
+  if (errno != 0 || end == value || *end != '\0' || parsed == 0)
+    return fallback;
+  return static_cast<uint64_t>(parsed);
+}
+
+std::string
+readIdentity(const char* variable, const char* fallback) noexcept
+{
+  try {
+    const char* value = std::getenv(variable);
+    std::string result = value != nullptr && *value != '\0' ? value : fallback;
+    for (char& ch : result) {
+      if (ch == ' ' || ch == '\t' || ch == '\n' || ch == '=')
+        ch = '_';
+    }
+    return result;
+  }
+  catch (...) {
+    return fallback;
+  }
+}
+
+uint64_t
+fnv1a(std::string_view value) noexcept
+{
+  uint64_t hash = 1469598103934665603ULL;
+  for (unsigned char ch : value) {
+    hash ^= ch;
+    hash *= 1099511628211ULL;
+  }
+  return hash;
+}
+
+void
+updateMin(std::atomic<uint64_t>& target, uint64_t value) noexcept
+{
+  uint64_t current = target.load(std::memory_order_relaxed);
+  while (value < current &&
+         !target.compare_exchange_weak(current, value, std::memory_order_relaxed)) {
+  }
+}
+
+void
+updateMax(std::atomic<uint64_t>& target, uint64_t value) noexcept
+{
+  uint64_t current = target.load(std::memory_order_relaxed);
+  while (value > current &&
+         !target.compare_exchange_weak(current, value, std::memory_order_relaxed)) {
+  }
+}
+
+struct Aggregate
+{
+  std::atomic<uint64_t> calls{0};
+  std::atomic<uint64_t> successes{0};
+  std::atomic<uint64_t> failures{0};
+  std::atomic<uint64_t> sampledCalls{0};
+  std::atomic<uint64_t> droppedRecords{0};
+  std::atomic<uint64_t> totalDurationNs{0};
+  std::atomic<uint64_t> minDurationNs{std::numeric_limits<uint64_t>::max()};
+  std::atomic<uint64_t> maxDurationNs{0};
+  std::atomic<uint64_t> totalBytes{0};
+  std::atomic<uint64_t> totalItems{0};
+};
+
+} // namespace
+
+struct Profiler::Impl
+{
+  bool enabled = false;
+  uint64_t sampleModulus = 100;
+  std::string cell = "unset";
+  std::string peer = "unset";
+  std::array<Aggregate, STAGE_COUNT> aggregates;
+  std::atomic<uint64_t> traceCounter{0};
+  std::atomic<bool> flushed{false};
+};
+
+namespace {
+
+thread_local uint64_t g_currentTraceId = 0;
+
+std::string
+traceIdToString(uint64_t traceId)
+{
+  std::array<char, 32> buffer{};
+  const auto result = std::to_chars(buffer.data(), buffer.data() + buffer.size(), traceId);
+  if (result.ec != std::errc())
+    return "0";
+  return std::string(buffer.data(), result.ptr);
+}
+
+} // namespace
+
+const StageDefinition&
+getStageDefinition(StageId stage) noexcept
+{
+  const size_t index = static_cast<size_t>(stage);
+  return STAGES[index < STAGES.size() ? index : 0];
+}
+
+size_t
+getStageCount() noexcept
+{
+  return STAGES.size();
+}
+
+Profiler&
+Profiler::get() noexcept
+{
+  static Profiler* instance = new Profiler();
+  return *instance;
+}
+
+Profiler::Profiler() noexcept
+  : m_impl(new Impl())
+{
+  m_impl->enabled = parseEnabled(std::getenv("NDN_SVS_PROFILE_ENABLED"));
+  m_impl->sampleModulus = parsePositive(std::getenv("NDN_SVS_PROFILE_SAMPLE_MODULUS"), 100);
+  m_impl->cell = readIdentity("NDN_SVS_PROFILE_CELL_ID", "unset");
+  m_impl->peer = readIdentity("NDN_SVS_PROFILE_PEER_ID", "unset");
+  if (m_impl->enabled) {
+    try {
+      NDN_LOG_TRACE("schema=spec133-profile-lifecycle-v1 event=profile-start"
+                    << " cell=" << m_impl->cell
+                    << " peer=" << m_impl->peer
+                    << " sampleModulus=" << m_impl->sampleModulus
+                    << " clock=CLOCK_MONOTONIC_RAW");
+    }
+    catch (...) {
+    }
+    std::atexit([] { Profiler::get().flush(); });
+  }
+}
+
+bool
+Profiler::isEnabled() const noexcept
+{
+  return m_impl->enabled;
+}
+
+bool
+Profiler::shouldSample(std::string_view traceKey) const noexcept
+{
+  return m_impl->enabled && fnv1a(traceKey) % m_impl->sampleModulus == 0;
+}
+
+uint64_t
+Profiler::nextTraceId() noexcept
+{
+  if (!m_impl->enabled)
+    return 0;
+  return m_impl->traceCounter.fetch_add(1, std::memory_order_relaxed) + 1;
+}
+
+uint64_t
+Profiler::currentTraceId() const noexcept
+{
+  return g_currentTraceId;
+}
+
+uint64_t
+Profiler::nowRawNs() const noexcept
+{
+  timespec now{};
+  if (::clock_gettime(CLOCK_MONOTONIC_RAW, &now) != 0)
+    return 0;
+  return static_cast<uint64_t>(now.tv_sec) * 1000000000ULL +
+         static_cast<uint64_t>(now.tv_nsec);
+}
+
+void
+Profiler::record(StageId stage, std::string_view traceKey, uint64_t startRawNs,
+                 uint64_t durationNs, Outcome outcome, uint64_t bytes, uint64_t items,
+                 CorrelationMode correlationMode, bool sampled) noexcept
+{
+  if (!m_impl->enabled)
+    return;
+  const size_t index = static_cast<size_t>(stage);
+  if (index >= STAGES.size())
+    return;
+  Aggregate& aggregate = m_impl->aggregates[index];
+  aggregate.calls.fetch_add(1, std::memory_order_relaxed);
+  if (outcome == Outcome::Success)
+    aggregate.successes.fetch_add(1, std::memory_order_relaxed);
+  else if (outcome != Outcome::Skipped)
+    aggregate.failures.fetch_add(1, std::memory_order_relaxed);
+  aggregate.totalDurationNs.fetch_add(durationNs, std::memory_order_relaxed);
+  aggregate.totalBytes.fetch_add(bytes, std::memory_order_relaxed);
+  aggregate.totalItems.fetch_add(items, std::memory_order_relaxed);
+  updateMin(aggregate.minDurationNs, durationNs);
+  updateMax(aggregate.maxDurationNs, durationNs);
+  if (!sampled)
+    return;
+  aggregate.sampledCalls.fetch_add(1, std::memory_order_relaxed);
+  const StageDefinition& definition = STAGES[index];
+  try {
+    NDN_LOG_TRACE("schema=spec133-stage-span-v1 event=stage-span"
+                  << " cell=" << m_impl->cell
+                  << " peer=" << m_impl->peer
+                  << " stage=" << definition.id
+                  << " kind=" << toString(definition.kind)
+                  << " thread=" << toString(definition.thread)
+                  << " parent=" << (definition.parent[0] == '\0' ? "none" : definition.parent)
+                  << " trace=" << traceKey
+                  << " startRawNs=" << startRawNs
+                  << " durationNs=" << durationNs
+                  << " outcome=" << toString(outcome)
+                  << " bytes=" << bytes
+                  << " items=" << items
+                  << " correlationMode=" << toString(correlationMode)
+                  << " sampleModulus=" << m_impl->sampleModulus);
+  }
+  catch (...) {
+    aggregate.droppedRecords.fetch_add(1, std::memory_order_relaxed);
+  }
+}
+
+void
+Profiler::recordInterval(StageId stage, uint64_t traceId, uint64_t startRawNs,
+                         uint64_t durationNs, Outcome outcome,
+                         CorrelationMode correlationMode) noexcept
+{
+  if (!m_impl->enabled)
+    return;
+  try {
+    const std::string traceKey = traceIdToString(traceId);
+    record(stage, traceKey, startRawNs, durationNs, outcome, 0, 1,
+           correlationMode, shouldSample(traceKey));
+  }
+  catch (...) {
+  }
+}
+
+void
+Profiler::flush() noexcept
+{
+  if (!m_impl->enabled || m_impl->flushed.exchange(true, std::memory_order_relaxed))
+    return;
+  for (size_t index = 0; index < STAGES.size(); ++index) {
+    const StageDefinition& definition = STAGES[index];
+    Aggregate& aggregate = m_impl->aggregates[index];
+    const uint64_t calls = aggregate.calls.load(std::memory_order_relaxed);
+    const uint64_t minimum = calls == 0 ? 0 : aggregate.minDurationNs.load(std::memory_order_relaxed);
+    try {
+      NDN_LOG_TRACE("schema=spec133-stage-summary-v1 event=stage-summary"
+                    << " cell=" << m_impl->cell
+                    << " peer=" << m_impl->peer
+                    << " stage=" << definition.id
+                    << " kind=" << toString(definition.kind)
+                    << " thread=" << toString(definition.thread)
+                    << " calls=" << calls
+                    << " successes=" << aggregate.successes.load(std::memory_order_relaxed)
+                    << " failures=" << aggregate.failures.load(std::memory_order_relaxed)
+                    << " sampledCalls=" << aggregate.sampledCalls.load(std::memory_order_relaxed)
+                    << " droppedRecords=" << aggregate.droppedRecords.load(std::memory_order_relaxed)
+                    << " totalDurationNs=" << aggregate.totalDurationNs.load(std::memory_order_relaxed)
+                    << " minDurationNs=" << minimum
+                    << " maxDurationNs=" << aggregate.maxDurationNs.load(std::memory_order_relaxed)
+                    << " totalBytes=" << aggregate.totalBytes.load(std::memory_order_relaxed)
+                    << " totalItems=" << aggregate.totalItems.load(std::memory_order_relaxed)
+                    << " sampleModulus=" << m_impl->sampleModulus);
+    }
+    catch (...) {
+      aggregate.droppedRecords.fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+  try {
+    NDN_LOG_TRACE("schema=spec133-profile-lifecycle-v1 event=profile-stop"
+                  << " cell=" << m_impl->cell
+                  << " peer=" << m_impl->peer
+                  << " sampleModulus=" << m_impl->sampleModulus);
+    boost::log::core::get()->flush();
+    std::clog.flush();
+  }
+  catch (...) {
+  }
+}
+
+TraceScope::TraceScope() noexcept
+  : TraceScope(Profiler::get().nextTraceId())
+{
+}
+
+TraceScope::TraceScope(uint64_t traceId) noexcept
+  : m_previous(g_currentTraceId)
+  , m_current(traceId)
+{
+  g_currentTraceId = traceId;
+}
+
+TraceScope::~TraceScope() noexcept
+{
+  g_currentTraceId = m_previous;
+}
+
+uint64_t
+TraceScope::id() const noexcept
+{
+  return m_current;
+}
+
+Span::Span(StageId stage, std::string_view traceKey,
+           CorrelationMode correlationMode) noexcept
+  : m_stage(stage)
+  , m_correlationMode(correlationMode)
+{
+  start(traceKey);
+}
+
+Span::Span(StageId stage, uint64_t traceId,
+           CorrelationMode correlationMode) noexcept
+  : m_stage(stage)
+  , m_correlationMode(correlationMode)
+{
+  try {
+    start(traceIdToString(traceId));
+  }
+  catch (...) {
+    m_enabled = false;
+  }
+}
+
+void
+Span::start(std::string_view traceKey) noexcept
+{
+  try {
+    Profiler& profiler = Profiler::get();
+    m_enabled = profiler.isEnabled();
+    if (!m_enabled)
+      return;
+    m_traceKey.assign(traceKey.data(), traceKey.size());
+    m_sampled = profiler.shouldSample(m_traceKey);
+    m_startRawNs = profiler.nowRawNs();
+  }
+  catch (...) {
+    m_enabled = false;
+  }
+}
+
+Span::~Span() noexcept
+{
+  stop();
+}
+
+void
+Span::setOutcome(Outcome outcome) noexcept
+{
+  m_outcome = outcome;
+}
+
+void
+Span::setCounts(uint64_t bytes, uint64_t items) noexcept
+{
+  m_bytes = bytes;
+  m_items = items;
+}
+
+void
+Span::stop() noexcept
+{
+  if (!m_enabled || m_stopped)
+    return;
+  m_stopped = true;
+  Profiler& profiler = Profiler::get();
+  const uint64_t endRawNs = profiler.nowRawNs();
+  const uint64_t durationNs = endRawNs >= m_startRawNs ? endRawNs - m_startRawNs : 0;
+  profiler.record(m_stage, m_traceKey, m_startRawNs, durationNs, m_outcome,
+                  m_bytes, m_items, m_correlationMode, m_sampled);
+}
+
+} // namespace ndn::svs::profile
