#!/usr/bin/env python3
APPNAME = 'ndnsf-spec203-experiment'
VERSION = '1.0'
top = '.'
out = 'build'

def options(opt):
    opt.load('compiler_cxx gnu_dirs')

def configure(conf):
    conf.load('compiler_cxx gnu_dirs')
    conf.env.CXXFLAGS += ['-std=c++17', '-O2', '-g0', '-Wall', '-Wextra']
    # Reuse the repository's existing header-only JSON dependency.
    conf.env.INCLUDES += [conf.path.find_dir('../../NDNSF-DistributedInference/cpp/vendor').abspath()]
    conf.check_cfg(package='libndn-service-framework libndn-cxx libndn-svs libnac-abe ndnsd',
                   args='--cflags --libs', uselib_store='NDNSF', mandatory=True)
    conf.env.NDNSF_NAC_LIBDIR = conf.cmd_and_log(
        ['/usr/bin/pkg-config', '--variable=libdir', 'libnac-abe']).strip()
    conf.env.prepend_value('INCLUDES', conf.cmd_and_log(
        ['/usr/bin/pkg-config', '--variable=includedir', 'libnac-abe']).strip())
    conf.check_cxx(header_name='nlohmann/json.hpp', mandatory=True)

def build(bld):
    for role in ('consumer', 'producer'):
        bld.program(target='spec203-nsc-' + role, source='../NDN_NSC/' + role + '.cpp',
                    use='NDNSF', lib=['pthread'], install_path='${BINDIR}',
                    rpath=[bld.env.NDNSF_NAC_LIBDIR, '/usr/local/lib'])
    for role in ('requester', 'provider', 'probe'):
        bld.program(target='spec203-sim-' + role, source=role + '.cpp',
                    use='NDNSF', lib=['pthread'], install_path='${BINDIR}',
                    rpath=[bld.env.NDNSF_NAC_LIBDIR, '/usr/local/lib'])
