name /example/uav/controller/NDNSF/ControllerPolicy/spec228-v1

provider-policies
{
    provider-policy
    {
        for /example/uav/drone/UAV1
        allow
        {
            /UAV/Telemetry/GetStatus
            /UAV/Tracking/SourceWindow
            /UAV/Tracking/Window
            /UAV/Tracking/Window/ROLE/Camera-UAV1
        }
    }
    provider-policy
    {
        for /example/uav/drone/UAV2
        allow
        {
            /UAV/Telemetry/GetStatus
            /UAV/Tracking/SourceWindow
            /UAV/Tracking/Window
            /UAV/Tracking/Window/ROLE/Camera-UAV2
        }
    }
    provider-policy
    {
        for /example/uav/drone/UAV3
        allow
        {
            /UAV/Telemetry/GetStatus
            /UAV/Tracking/SourceWindow
            /UAV/Tracking/Window
            /UAV/Tracking/Window/ROLE/Camera-UAV3
        }
    }
    provider-policy
    {
        for /example/uav/compute
        allow
        {
            /UAV/Telemetry/GetStatus
            /UAV/Tracking/Window
            /UAV/Tracking/Window/ROLE/Tracking-Compute
        }
    }
}

user-policies
{
    user-policy
    {
        for /example/uav/gs
        allow
        {
            /UAV/Telemetry/GetStatus
            /UAV/Tracking/SourceWindow
            /UAV/Tracking/Window
        }
    }
}
