#!/usr/bin/env python3
"""Repository-owned Spec175 candidate-closure validator."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[3]
LIB = ROOT / "packaging/ndnsf-di-container/lib"
if str(LIB) not in sys.path:
    sys.path.insert(0, str(LIB))

from spec175_candidate_closure import validate  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--manifest", required=True, type=Path)
    parser.add_argument("--gate", required=True)
    parser.add_argument("--expected-sif", type=Path)
    parser.add_argument("--expected-sif-sha256")
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    result = validate(
        args.manifest,
        expected_gate=args.gate,
        expected_sif=args.expected_sif,
        expected_sif_sha256=args.expected_sif_sha256,
    )
    rendered = json.dumps(result, indent=2, sort_keys=True) + "\n"
    if args.output is not None:
        output = args.output.expanduser().resolve()
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(rendered, encoding="utf-8")
    print(rendered, end="")
    return 0 if result["status"] == "PASS" else 2


if __name__ == "__main__":
    raise SystemExit(main())
