{
  "schemaVersion": "ndnsf-di-layer-lock-v1",
  "layer": "app-runtime",
  "sourcePolicy": "allowlisted-working-tree-snapshot",
  "sources": {
    "NDNSD": {
      "url": "https://github.com/matianxing1992/NDNSD.git",
      "revision": "25f7ad9d2f8848c10025e71358e3dafd62c348c0",
      "sourcePolicy": "sealed-archive"
    },
    "ndn-svs": {
      "pathHint": "/home/tianxing/NDN/ndn-svs",
