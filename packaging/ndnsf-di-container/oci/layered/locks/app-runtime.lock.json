    }
  },
  "installPrefix": "/opt/ndnsf-app",
  "pythonTarget": "/opt/ndnsf-app/python",
  "buildCompatibilityPatches": {
    "ndn-svs-boost-1.71": {
      "path": "packaging/ndnsf-di-container/oci/layered/patches/ndn-svs-boost-1.71.patch",
      "sha256": "5f43f4d797c80ee3afaf80820f7bc395f362b84aebd892b785d5c7fbca6d3aed",
      "scope": "build-only sealed ndn-svs wscript compatibility",
      "allowedChanges": [
        "BOOST_VERSION_NUMBER < 107400 -> BOOST_VERSION_NUMBER < 107100",
        "minimum supported version of Boost is 1.74.0 -> minimum supported version of Boost is 1.71.0"
      ]
    }
  },
  "workspaceIncludeRoots": [
    ".waf-tools",
    "waf",
    "wscript",
    "libndn-service-framework.pc.in",
    "ndn-service-framework",
    "NDNSF-DistributedRepo",
    "NDNSF-DistributedInference",
    "NDNSF-UAV-APP",
    "examples",
    "pythonWrapper"
  ],
  "ownerProfiles": [
    "core",
    "sdk",
    "app",
    "planner",
    "adapters/onnx",
    "adapters/qwen",
    "adapters/llama",
    "ops",
    "compat"
  ],
  "runtimePythonPackages": {
    "cffi": "1.17.1",
    "cryptography": "44.0.1",
    "pycparser": "2.22"
  },
  "excludedContent": [
    ".git",
    ".codegraph",
    ".planning",
    ".specify",
    "build",
    "__pycache__",
    "*.pyc",
    "results",
    "RELEASE",
    "Experiments",
    "videos",
    "models",
    "identities",
    "secrets",
    "*.onnx",
    "*.pt",
    "*.safetensors",
    "*.gguf",
    "*.key",
    "*.pem",
    "*.p12"
  ],
  "cpuFallbackAllowed": false
