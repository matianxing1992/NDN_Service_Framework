[Unit]
Description=NDNSF-DI service controller
After=network-online.target nfd.service
Requires=nfd.service
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=ndnsf-di
Group=ndnsf-di
Environment=HOME=/var/lib/ndnsf-di/identities/controller
Environment=NDNSF_DI_IDENTITY=/ndnsf/di/controller
Environment=NDN_CLIENT_PIB=pib-sqlite3: NDN_CLIENT_TPM=tpm-file:
Environment=NDN_LOG=*=NONE
EnvironmentFile=/etc/ndnsf-di/controller.env
ExecStartPre=/opt/ndnsf-di/current/bin/ndnsf-identity-check ${HOME} ${NDNSF_DI_IDENTITY}
ExecStart=/opt/ndnsf-di/current/bin/App_ServiceController $NDNSF_DI_CONTROLLER_ARGS
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=20s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/run/ndnsf-di /var/lib/ndnsf-di/identities /var/log/ndnsf-di

[Install]
WantedBy=ndnsf-di-controller.target
