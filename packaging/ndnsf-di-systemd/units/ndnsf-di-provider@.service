[Unit]
Description=NDNSF-DI provider %i
After=network-online.target nfd.service ndnsf-di-controller.service
Requires=nfd.service
PartOf=ndnsf-di-providers.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=ndnsf-di
Group=ndnsf-di
Environment=HOME=/var/lib/ndnsf-di/identities/provider-%i
Environment=NDNSF_DI_IDENTITY=/ndnsf/di/provider/%i
Environment=NDN_CLIENT_PIB=pib-sqlite3: NDN_CLIENT_TPM=tpm-file:
Environment=NDN_LOG=*=NONE
EnvironmentFile=/etc/ndnsf-di/provider-%i.env
ExecStartPre=/opt/ndnsf-di/current/bin/ndnsf-identity-check ${HOME} ${NDNSF_DI_IDENTITY}
ExecStart=/opt/ndnsf-di/current/bin/di-native-provider $NDNSF_DI_PROVIDER_ARGS
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/run/ndnsf-di /var/lib/ndnsf-di/cache /var/lib/ndnsf-di/identities /var/log/ndnsf-di

[Install]
WantedBy=ndnsf-di-providers.target
