NDNSF_CONTROLLER_CERT_FILE=/etc/ndnsf-di/controller.cert
SPEC181_GRANT_AUTHORITY_PUBLIC_KEY=/etc/ndnsf-di/trust/authority.pub
SPEC181_PROVIDER_RECIPIENT_KEY_MAP=/etc/ndnsf-di/provider-0-recipients.json
NDNSF_DI_PROVIDER_ARGS=--plan /etc/ndnsf-di/plan.json --manifest /opt/ndnsf-di/current/share/model-manifest.json --tokenizer-json /etc/ndnsf-di/tokenizer.json --selection-offer-key-file /etc/ndnsf-di/provider-0-offer.pem --provider /ndnsf/di/provider/0 --controller /ndnsf/di/controller --group /ndnsf/di/group --service /ndnsf/di/inference --repo-service /ndnsf/di/repo --trust-schema /etc/ndnsf-di/trust-schema.conf --artifact-cache-dir /var/lib/ndnsf-di/cache/provider-0 --statistics-file /var/log/ndnsf-di/provider-0-statistics.jsonl --roles /LLM/Stage/0 --serve --require-execution-lease
